---
import { getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import { Icon } from "astro-icon/components";
import { addpaymentConfig } from "@/config";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const { methods } = addpaymentConfig;

const sponsorsPost = await getEntry("spec", "sponsors");

if (!sponsorsPost) {
	throw new Error("Sponsors page content not found");
}

if (!siteConfig.featurePages.sponsors) {
	return Astro.redirect("/404/");
}

const { Content } = await render(sponsorsPost);
const title = i18n(I18nKey.sponsors);
---

<MainGridLayout title={title}>
    <!-- 引入右侧边栏布局管理器 -->
    <script>
        import("../scripts/right-sidebar-layout.js");
    </script>
    <div
        class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
    >
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="flex flex-col items-start justify-center mb-8">
                <h1
                    class="text-4xl font-bold text-90 mb-2 relative
                        before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                        before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
                >
                    {title}
                </h1>
            </div>

            <div class="mb-6">
                <p class="text-md text-[#374151] dark:text-[#D1D5DB]">
                    {i18n(I18nKey.sponsorsNotice1)}
                </p>
                <br />
                <p class="text-md font-bold text-90">
                    {i18n(I18nKey.sponsorsNotice2)}
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-5">
                {
                    methods.map((method) => (
                        <div class="bg-[var(--btn-regular-bg)] rounded-xl p-8 shadow-sm hover:shadow-lg dark:hover:shadow-lg dark:hover:shadow-white/30 transition-shadow duration-300">
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class={`h-10 w-10 rounded-lg ${method.color} flex items-center justify-center`}
                                >
                                    <Icon
                                        name={method.icon}
                                        class="text-[1.5rem] text-white"
                                    />
                                </div>
                                <div>
                                    <h2 class="ignore text-lg font-bold text-90">
                                        {method.name}
                                    </h2>
                                    <p class="text-sm text-60">
                                        {i18n(I18nKey.scanPayQRcode)}
                                    </p>
                                </div>
                            </div>

                            <div class="flex-1 flex items-center justify-center">
                                <img
                                    src={method.qrCode}
                                    alt={method.name}
                                    class="max-h-48 object-contain"
                                />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>

    <br />

    <div
        class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
    >
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="flex flex-col items-start justify-center mb-8">
                <h1
                    class="text-3xl font-bold text-90 mb-2 relative
                          before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                          before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
                >
                    {i18n(I18nKey.sponsorsPartner)}
                </h1>
            </div>

            <!-- 从MD文件读取的内容 -->
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>

    <br />

    <div
        class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
    >
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <!-- 页面标题 -->
            <div class="flex flex-col items-start justify-center mb-8">
                <h1
                    class="text-3xl font-bold text-90 mb-2 relative
                          before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                          before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
                >
                    {i18n(I18nKey.otherSupportOptions)}
                </h1>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-5 gap-y-5">
                <!-- 分享博客卡片 -->
                <div
                    class="bg-[var(--btn-regular-bg)] rounded-xl p-8 shadow-sm hover:shadow-lg dark:hover:shadow-lg dark:hover:shadow-white/30 transition-shadow duration-300"
                >
                    <Icon
                        name="material-symbols:share-outline"
                        class="text-4xl m-0 mb-4 text-left text-[var(--btn-content)]"
                    />
                    <p class="text-md font-normal text-75">
                        {i18n(I18nKey.shareBlog)}
                    </p>
                </div>

                <!-- 留言卡片 -->
                <div
                    class="bg-[var(--btn-regular-bg)] rounded-xl p-8 shadow-sm hover:shadow-lg dark:hover:shadow-lg dark:hover:shadow-white/30 transition-shadow duration-300"
                >
                    <Icon
                        name="material-symbols:edit-note-outline"
                        class="text-4xl m-0 mb-4 text-left text-[var(--btn-content)]"
                    />
                    <p class="text-md font-normal text-75">
                        {i18n(I18nKey.leaveComment)}
                    </p>
                </div>

                <!-- 订阅文章卡片 -->
                <div
                    class="bg-[var(--btn-regular-bg)] rounded-xl p-8 shadow-sm hover:shadow-lg dark:hover:shadow-lg dark:hover:shadow-white/30 transition-shadow duration-300"
                >
                    <Icon
                        name="material-symbols:rss-feed"
                        class="text-4xl m-0 mb-4 text-left text-[var(--btn-content)]"
                    />
                    <p class="text-md font-normal text-75">
                        {i18n(I18nKey.subscribeToArticles)}
                    </p>
                </div>
            </div>
        </div>
    </div>
</MainGridLayout>
