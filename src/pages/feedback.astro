---
import { getEntry, render } from "astro:content";
import Twikoo from "@components/comment/Twikoo.astro";
import FriendQRCode from "@components/FriendQRCode.astro";
import Markdown from "@components/misc/Markdown.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, contactEmailConfig, contactMethods } from "@/config";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

// 使用数组方式获取添加好友的二维码（从配置中过滤出有值的）
const availableQRCodes = contactMethods
	.filter((method) => method.qrCode)
	.map((method) => method.qrCode);

const feedbackPost = await getEntry("spec", "feedback");

if (!feedbackPost) {
	throw new Error("Feedback page content not found");
}

if (!siteConfig.featurePages.feedback) {
	return Astro.redirect("/404/");
}

const { Content } = await render(feedbackPost);
const title = i18n(I18nKey.feedback);

const path = Astro.url.pathname;

let commentService = "";
if (commentConfig?.enable && commentConfig?.twikoo) {
	commentService = "twikoo";
}
---

<MainGridLayout title={title}>
  <!-- 引入右侧边栏布局管理器 -->
  <script>
    import("../scripts/right-sidebar-layout.js");
  </script>

  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex flex-col items-start justify-center mb-8">
        <h1
          class="text-4xl font-bold text-90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
        >
          {title}
        </h1>
      </div>

      <!-- 从MD文件读取的内容 -->
      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </div>
  </div>

  <br />

  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="flex flex-col items-start justify-center mb-8">
        <h1
          class="text-3xl font-bold text-90 mb-2 relative
                  before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                  before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
        >
          {i18n(I18nKey.contactMe)}
        </h1>
      </div>

      <!-- 联系站长方式 -->
      <div class="flex flex-col gap-4">
        <!-- 联系站长电子邮箱方式 -->
        <div class="py-2">
          <div class="flex flex-row items-center justify-between gap-3">
            <div class="flex items-center min-w-0">
              <div
                class="w-12 h-12 bg-[var(--btn-regular-bg)] rounded-xl flex items-center justify-center mr-4 shrink-0"
              >
                <Icon
                  name="material-symbols:mail-outline"
                  class="text-[var(--btn-content)] text-2xl"
                />
              </div>
              <div class="min-w-0">
                <h2 class="font-bold text-90 mb-1">
                  {i18n(I18nKey.contactEmail)}
                </h2>
              </div>
            </div>
            <div class="flex flex-row items-center gap-3 shrink-0">
              <button
                id="show-email-btn"
                class="btn-regular rounded-lg px-4 py-3 transition-all duration-300 text-sm whitespace-nowrap inline-flex items-center justify-center gap-2"
              >
                {i18n(I18nKey.viewEmail)}
              </button>
            </div>
          </div>
        </div>

        <!-- 联系站长添加好友方式 -->
        <div class="py-2">
          <div class="flex flex-row items-center justify-between gap-3">
            <div class="flex items-center min-w-0">
              <div
                class="w-12 h-12 bg-[var(--btn-regular-bg)] rounded-xl flex items-center justify-center mr-4 shrink-0"
              >
                <Icon
                  name="material-symbols:group-add-outline"
                  class="text-[var(--btn-content)] text-2xl"
                />
              </div>
              <div class="min-w-0">
                <h2 class="font-bold text-90 mb-1">
                  {i18n(I18nKey.contactSocialFriends)}
                </h2>
              </div>
            </div>
            <div class="flex flex-row items-center gap-3 shrink-0">
              <button
                id="show-qrcode-btn"
                class="btn-regular rounded-lg px-4 py-3 transition-all duration-300 text-sm whitespace-nowrap inline-flex items-center justify-center gap-2"
              >
                {i18n(I18nKey.addFriends)}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <br />

  <!-- Twikoo 评论系统 -->
  <div class="card-base p-6 mb-4">
    <div
      id="twikoo-initializing"
      class="flex flex-col items-center justify-center py-12 text-center"
    >
      <div class="twikoo-spinner mb-3">
        <svg class="twikoo-spinner-svg" viewBox="0 0 48 48">
          <circle
            class="twikoo-spinner-track"
            cx="24"
            cy="24"
            r="20"
            fill="none"
            stroke-width="4"></circle>
          <circle
            class="twikoo-spinner-arc"
            cx="24"
            cy="24"
            r="20"
            fill="none"
            stroke-width="4"
            stroke-linecap="round"></circle>
        </svg>
      </div>
      <p class="text-lg font-bold text-90">
        {i18n(I18nKey.twikooInitializing)}
      </p>
    </div>
    {
      commentService === "twikoo" && (
        <div id="twikoo-comment-container" class="hidden">
          <Twikoo path={path} />
        </div>
      )
    }
    <div
      id="twikoo-not-configured"
      class="hidden flex-col items-center justify-center py-12 text-center"
    >
      <div
        class="w-16 h-16 rounded-xl flex items-center justify-center bg-[var(--btn-regular-bg)] text-[var(--btn-content)] mb-4"
      >
        <Icon
          name="material-symbols:chat-bubble-off-outline"
          class="text-4xl"
        />
      </div>
      <p class="text-lg font-bold text-90">
        {i18n(I18nKey.twikooNotConfigured)}
      </p>
      <p class="text-sm text-60 mt-1">
        {i18n(I18nKey.twikooConfigHint)}
      </p>
    </div>
    <div
      id="twikoo-privacy-rejected"
      class="hidden flex-col items-center justify-center py-12 text-center"
    >
      <div
        class="w-16 h-16 rounded-xl flex items-center justify-center bg-[var(--btn-regular-bg)] text-[var(--btn-content)] mb-4"
      >
        <Icon name="material-symbols:block-outline" class="text-4xl" />
      </div>
      <p class="text-lg font-bold text-90">
        {i18n(I18nKey.twikooPrivacyRejected)}
      </p>
    </div>
    <script is:inline>
      (function () {
        var consent = localStorage.getItem("siteNoticeConsent");
        var initializing = document.getElementById("twikoo-initializing");
        var twikooContainer = document.getElementById(
          "twikoo-comment-container",
        );
        var notConfigured = document.getElementById("twikoo-not-configured");
        var privacyRejected = document.getElementById(
          "twikoo-privacy-rejected",
        );

        function updateTwikooState(c) {
          if (c !== "accepted" && c !== "rejected") return;
          if (initializing) initializing.classList.add("hidden");
          if (c === "rejected") {
            if (twikooContainer) twikooContainer.classList.add("hidden");
            if (notConfigured) {
              notConfigured.classList.add("hidden");
              notConfigured.classList.remove("flex");
            }
            if (privacyRejected) {
              privacyRejected.classList.remove("hidden");
              privacyRejected.classList.add("flex");
            }
          } else {
            if (privacyRejected) {
              privacyRejected.classList.add("hidden");
              privacyRejected.classList.remove("flex");
            }
            if (twikooContainer) {
              twikooContainer.classList.remove("hidden");
              if (notConfigured) {
                notConfigured.classList.add("hidden");
                notConfigured.classList.remove("flex");
              }
            } else {
              if (notConfigured) {
                notConfigured.classList.remove("hidden");
                notConfigured.classList.add("flex");
              }
            }
          }
        }

        updateTwikooState(consent);

        window.addEventListener("siteNoticeConsentChange", function (e) {
          updateTwikooState(e.detail);
        });
      })();
    </script>
  </div>

  <!-- 添加好友二维码对话框 - 使用数组方式传递 -->
  <FriendQRCode qrCodes={availableQRCodes} />

  <!-- 邮箱地址对话框 -->
  <dialog
    id="email-dialog"
    class="dialog fixed inset-0 m-auto rounded-[var(--radius-large)] bg-[var(--float-panel-bg)] p-0 w-[90%] max-w-[480px] shadow-lg overflow-hidden transition-all duration-250 ease-[cubic-bezier(0.2,0,0,1)] opacity-0 scale-95 translate-y-2.5 dialog-show:opacity-100 dialog-show:scale-100 dialog-show:translate-y-0"
  >
    <div class="relative z-10 p-8 pb-7 flex flex-col gap-5">
      <!-- 标题 -->
      <div
        class="flex items-center justify-center gap-2.5 text-[var(--primary)]"
      >
        <Icon name="material-symbols:mail-outline" class="text-3xl" />
        <h3 class="m-0 text-xl font-bold text-[var(--btn-plain)]">
          {i18n(I18nKey.viewEmail)}
        </h3>
      </div>

      <!-- 邮箱列表 -->
      <div class="flex flex-col gap-3">
        {
          contactEmailConfig.emails.map((emailItem, index) => (
            <div class="flex flex-col gap-1.5">
              <h4 class="m-0 text-sm font-bold text-[var(--content-meta)]">
                {i18n(I18nKey.emailIndex).replace("{n}", String(index + 1))}
              </h4>
              <div class="ignore flex items-center justify-between gap-3 bg-[var(--codeblock-bg)] rounded-xl py-3 px-4">
                <p class="text-[var(--inline-code-color)] break-all m-0 font-mono text-sm leading-[1.4] line-clamp-2">
                  {emailItem.email}
                </p>
                <button
                  type="button"
                  class="copy-and-go-btn flex-shrink-0 bg-transparent border-none text-[var(--primary)] cursor-pointer p-1.5 rounded-lg flex items-center justify-center hover:bg-[var(--btn-plain-bg-hover)] transition-colors duration-300"
                  data-email={emailItem.email}
                  data-link={emailItem.link}
                  title={i18n(I18nKey.openEmailLink)}
                >
                  <Icon name="material-symbols:login" class="text-2xl block" />
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <p
        class="m-0 flex items-center justify-center gap-1.5 text-sm text-[var(--content-meta)]"
      >
        <Icon
          name="material-symbols:info-outline"
          class="text-xl text-[var(--primary)]"
        />
        {i18n(I18nKey.openEmailLink)}
      </p>

      <!-- 底部按钮区 -->
      <div class="flex justify-center items-center gap-3 mt-2">
        <button
          id="email-dialog-close-btn"
          class="border-none rounded-[8px] py-2.5 px-7 text-base font-bold cursor-pointer transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] active:scale-95 bg-transparent border-2 border-[var(--primary)] text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)]"
        >
          {i18n(I18nKey.cancelText)}
        </button>
      </div>
    </div>
  </dialog>

  <!-- 添加好友按钮点击事件 -->
  <script>
    // 使用事件委托，确保按钮即使被重新创建也能正常工作
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        target.id === "show-qrcode-btn" ||
        target.closest("#show-qrcode-btn")
      ) {
        e.preventDefault();

        // 等待一小段时间确保对话框已初始化
        const showDialog = () => {
          if (typeof (window as any).showContactDialog === "function") {
            (window as any).showContactDialog();
          } else {
            console.warn("showContactDialog not ready, retrying...");
            setTimeout(showDialog, 50);
          }
        };

        showDialog();
      }
    });

    // 复制邮箱地址
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest(
        ".copy-and-go-btn",
      ) as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();

      const email = btn.dataset.email;
      const href = btn.dataset.link;
      if (!href) return;

      if (email && navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(email);
        } catch (err) {
          console.error("copy error", err);
        }
      }

      const askConfirm = (window as any).openExternalLinkConfirm as
        | ((url: string, onConfirm?: (url: string) => void) => boolean)
        | undefined;

      const openLink = () => {
        window.open(href, "_blank", "noopener,noreferrer");
      };

      if (typeof askConfirm === "function" && askConfirm(href, openLink)) {
        return;
      }

      openLink();
    });

    // 邮箱弹窗
    const getEmailDialog = () =>
      document.getElementById("email-dialog") as HTMLDialogElement | null;

    const closeEmailDialog = () => {
      const dialog = getEmailDialog();
      if (!dialog) return;
      dialog.classList.remove("dialog-show");
      setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 250);
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      if (target.id === "show-email-btn" || target.closest("#show-email-btn")) {
        e.preventDefault();
        const dialog = getEmailDialog();
        if (!dialog) return;
        dialog.showModal();
        requestAnimationFrame(() => dialog.classList.add("dialog-show"));
        return;
      }

      if (
        target.id === "email-dialog-close-btn" ||
        target.closest("#email-dialog-close-btn")
      ) {
        e.preventDefault();
        closeEmailDialog();
        return;
      }

      if (target instanceof HTMLDialogElement && target.id === "email-dialog") {
        closeEmailDialog();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const dialog = getEmailDialog();
      if (dialog?.open) closeEmailDialog();
    });
  </script>
</MainGridLayout>

<style>
  .dialog.dialog-show {
    @apply opacity-100 scale-100 translate-y-0;
  }

  .dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .dialog.dialog-show::backdrop {
    opacity: 1;
  }

  .twikoo-spinner {
    width: 40px;
    height: 40px;
  }

  .twikoo-spinner-svg {
    width: 100%;
    height: 100%;
    animation: twikoo-spinner-rotate 2s linear infinite;
  }

  .twikoo-spinner-track {
    stroke: rgba(156, 163, 175, 0.2);
  }

  .twikoo-spinner-arc {
    stroke: var(--primary);
    stroke-dasharray: 80, 200;
    stroke-dashoffset: 0;
    animation: twikoo-spinner-dash 1.5s ease-in-out infinite;
  }

  @keyframes twikoo-spinner-rotate {
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes twikoo-spinner-dash {
    0% {
      stroke-dasharray: 1, 200;
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dasharray: 80, 200;
      stroke-dashoffset: -35;
    }
    100% {
      stroke-dasharray: 80, 200;
      stroke-dashoffset: -124;
    }
  }
</style>
