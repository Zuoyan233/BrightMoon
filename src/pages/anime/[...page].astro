---
import fs from "node:fs";
import path from "node:path";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import { sidebarLayoutConfig, siteConfig } from "../../config";
import localAnimeList from "../../data/anime";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";
import "../../styles/anime.css";

interface AnimeItem {
	title: string;
	cover: string;
	link: string;
	status: string;
	rating: number;
	progress: number;
	totalEpisodes: number;
	description: string;
	year: string;
	studio: string;
	genre: string[];
}

interface RawAnimeData {
	title?: string;
	cover?: string;
	link?: string;
	status?: string;
	rating?: number | string;
	progress?: number | string;
	totalEpisodes?: number | string;
	description?: string;
	year?: string;
	studio?: string;
	genre?: string[];
}

interface AnimePageProps {
	animeList?: AnimeItem[];
}

// 检查追番页面是否启用
if (!siteConfig.featurePages.anime) {
	return Astro.redirect("/404/");
}

const isBothSidebarMode = sidebarLayoutConfig.position === "both";
const BANGUMI_USER_ID = siteConfig.anime?.bangumi?.userId || "";
const BILIBILI_VMID = siteConfig.anime?.bilibili?.vmId || "";
const ANIME_MODE = siteConfig.anime?.mode || "local";

// 分页大小（前端模板与客户端脚本共用；getStaticPaths 内的分页大小需与此保持一致）
const PAGE_SIZE = 10;

// 生成主页面 + 旧版静态分页路径（旧 URL 重定向回主页面）
// 注意：getStaticPaths 运行在独立上下文，无法访问 frontmatter 局部变量，需在此独立加载数据
export const getStaticPaths = (() => {
	const _ANIME_MODE = siteConfig.anime?.mode || "local";
	let animeList: AnimeItem[] = [];
	if (_ANIME_MODE === "local") {
		// 使用本地数据
		animeList = localAnimeList;
	} else if (_ANIME_MODE === "bilibili") {
		// 从 Bilibili 数据文件加载
		const isDev = import.meta.env.DEV;
		const shouldFetchOnDev = siteConfig.anime?.bilibili?.fetchOnDev ?? false;
		const skipLoad = isDev && !shouldFetchOnDev;
		if (skipLoad) {
			console.log("[Dev] Skipping Bilibili data load (fetchOnDev is off).");
			animeList = [];
		} else {
			try {
				const dataPath = path.join(
					process.cwd(),
					"src/data/bilibili-data.json",
				);
				if (fs.existsSync(dataPath)) {
					const fileContent = fs.readFileSync(dataPath, "utf-8");
					const rawData = JSON.parse(fileContent);
					animeList = rawData.map((item: RawAnimeData) => ({
						title: item.title || "Unknown",
						cover: item.cover || "",
						link: item.link || "",
						status: item.status || "planned",
						rating: Number(item.rating) || 0,
						progress: Number(item.progress) || 0,
						totalEpisodes: Number(item.totalEpisodes) || 12,
						description: item.description || "",
						year: item.year || "",
						studio: item.studio || "",
						genre: Array.isArray(item.genre) ? item.genre : [],
					}));
				} else {
					console.warn(`Bilibili data file not found at ${dataPath}.`);
					animeList = [];
				}
			} catch (error) {
				console.error("Failed to load Bilibili anime data:", error);
				animeList = [];
			}
		}
	} else {
		// 从 Bangumi 数据文件加载
		const isDev = import.meta.env.DEV;
		const shouldFetchOnDev = siteConfig.anime?.bangumi?.fetchOnDev ?? false;
		const skipLoad = isDev && !shouldFetchOnDev;
		if (skipLoad) {
			console.log("[Dev] Skipping Bangumi data load (fetchOnDev is off).");
			animeList = [];
		} else {
			try {
				const dataPath = path.join(process.cwd(), "src/data/bangumi-data.json");
				if (fs.existsSync(dataPath)) {
					const fileContent = fs.readFileSync(dataPath, "utf-8");
					const rawData = JSON.parse(fileContent);
					animeList = rawData.map((item: RawAnimeData) => ({
						title: item.title || "Unknown",
						cover: item.cover || "",
						link: item.link || "",
						status: item.status || "planned",
						rating: Number(item.rating) || 0,
						progress: Number(item.progress) || 0,
						totalEpisodes: Number(item.totalEpisodes) || 12,
						description: item.description || "",
						year: item.year || "",
						studio: item.studio || "",
						genre: Array.isArray(item.genre) ? item.genre : [],
					}));
				} else {
					console.warn(`Bangumi data file not found at ${dataPath}.`);
					animeList = [];
				}
			} catch (error) {
				console.error("Failed to load anime data:", error);
				animeList = [];
			}
		}
	}
	const lastPage = Math.max(1, Math.ceil(animeList.length / 10));
	const paths: {
		params: { page: string | undefined };
		props: Record<string, unknown>;
	}[] = [{ params: { page: undefined }, props: { animeList } }];
	for (let p = 2; p <= lastPage; p++) {
		paths.push({ params: { page: String(p) }, props: {} });
	}
	return paths;
}) satisfies GetStaticPaths;

const pageProps = Astro.props as AnimePageProps;
// 旧版分页 URL（/anime/2/ 等）：输出 meta-refresh 跳转回主页面
const isLegacyPage = !pageProps.animeList;
const animeList: AnimeItem[] = pageProps.animeList ?? [];
const len = animeList.length;
const redirectUrl = url("/anime/");

// 获取番剧状态信息（文本、样式、图标）
function getStatusInfo(status: string) {
	switch (status) {
		case "watching":
			return {
				text: i18n(I18nKey.animeStatusWatching),
				class:
					"bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
				icon: "▶",
			};
		case "completed":
			return {
				text: i18n(I18nKey.animeStatusCompleted),
				class:
					"bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
				icon: "✓",
			};
		case "planned":
			return {
				text: i18n(I18nKey.animeStatusPlanned),
				class:
					"bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
				icon: "❤",
			};
		case "onhold":
			return {
				text: i18n(I18nKey.animeStatusOnHold),
				class:
					"bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
				icon: "⏸",
			};
		case "dropped":
			return {
				text: i18n(I18nKey.animeStatusDropped),
				class: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300",
				icon: "✗",
			};
		default:
			return {
				text: status,
				class: "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
				icon: "?",
			};
	}
}
---

{
	isLegacyPage && (
		<html>
			<head>
				<meta charset="utf-8" />
				<meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
				<link rel="canonical" href={redirectUrl} />
				<title>{i18n(I18nKey.anime)}</title>
			</head>
			<body>
				<a href={redirectUrl}>{redirectUrl}</a>
			</body>
		</html>
	)
}

{
	!isLegacyPage && (
		<MainGridLayout
			title={i18n(I18nKey.anime)}
			description={i18n(I18nKey.animeSubtitle)}
		>
			<div
				class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
			>
				<div class="card-base anime-card-base z-10 px-9 py-6 relative w-full">
					<div class="relative w-full mb-8">
						<div class="mb-6">
							<h1
								class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                    before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
							>
								{i18n(I18nKey.anime)}
							</h1>
							<p class="text-black/75 dark:text-white/75">
								{i18n(I18nKey.animeSubtitle)}
							</p>
						</div>

						<div class="mb-6">
							<div class="anime-filter-container flex flex-wrap gap-2">
								<button
									class="anime-filter-tag anime-active"
									data-status="all"
								>
									<span class="inline-flex items-center justify-center">
										<Icon name="material-symbols:apps" class="w-4 h-4" />
									</span>
									<span>{i18n(I18nKey.animeFilterAll)}</span>
									<span class="anime-filter-count">{animeList.length}</span>
								</button>
								<button class="anime-filter-tag" data-status="watching">
									<span class="inline-flex items-center justify-center">
										<Icon name="material-symbols:play-arrow" class="w-4 h-4" />
									</span>
									<span>{i18n(I18nKey.animeStatusWatching)}</span>
									<span class="anime-filter-count">{animeList.filter(a => a.status === "watching").length}</span>
								</button>
								<button class="anime-filter-tag" data-status="planned">
									<span class="inline-flex items-center justify-center">
										<Icon name="material-symbols:bookmark-outline" class="w-4 h-4" />
									</span>
									<span>{i18n(I18nKey.animeStatusPlanned)}</span>
									<span class="anime-filter-count">{animeList.filter(a => a.status === "planned").length}</span>
								</button>
								<button class="anime-filter-tag" data-status="completed">
									<span class="inline-flex items-center justify-center">
										<Icon name="material-symbols:check-circle-outline" class="w-4 h-4" />
									</span>
									<span>{i18n(I18nKey.animeStatusCompleted)}</span>
									<span class="anime-filter-count">{animeList.filter(a => a.status === "completed").length}</span>
								</button>
								{
									(ANIME_MODE === "bangumi" ||
										ANIME_MODE === "bilibili") && (
										<>
											<button
												class="anime-filter-tag"
												data-status="onhold"
											>
												<span class="inline-flex items-center justify-center">
													<Icon name="material-symbols:pause-circle-outline" class="w-4 h-4" />
												</span>
												<span>{i18n(I18nKey.animeStatusOnHold)}</span>
												<span class="anime-filter-count">{animeList.filter(a => a.status === "onhold").length}</span>
											</button>
											<button
												class="anime-filter-tag"
												data-status="dropped"
											>
												<span class="inline-flex items-center justify-center">
													<Icon name="material-symbols:cancel-outline" class="w-4 h-4" />
												</span>
												<span>{i18n(I18nKey.animeStatusDropped)}</span>
												<span class="anime-filter-count">{animeList.filter(a => a.status === "dropped").length}</span>
											</button>
										</>
									)
								}
							</div>
						</div>
					</div>

					<div class="mb-8">
						{
							ANIME_MODE === "bilibili" &&
							(!BILIBILI_VMID || BILIBILI_VMID === "") ? (
								<div class="text-center py-12">
									<Icon
										name="material-symbols:sentiment-sad-outline"
										class="w-12 h-12 mb-4 mx-auto block text-[var(--primary)]"
									/>
									<h3 class="text-xl font-bold text-black/80 dark:text-white/80 mb-2">
										{i18n(I18nKey.animeEmpty)}
									</h3>
									<p class="text-black/60 dark:text-white/60">
										{i18n(I18nKey.animeSetBilibiliVmId)}
									</p>
								</div>
							) : ANIME_MODE !== "local" &&
			              ANIME_MODE !== "bilibili" &&
			              BANGUMI_USER_ID === "your-user-id" ? (
								<div class="text-center py-12">
									<Icon
										name="material-symbols:sentiment-sad-outline"
										class="w-12 h-12 mb-4 mx-auto block text-[var(--primary)]"
									/>
									<h3 class="text-xl font-bold text-black/80 dark:text-white/80 mb-2">
										{i18n(I18nKey.animeEmpty)}
									</h3>
									<p class="text-black/60 dark:text-white/60">
										{i18n(I18nKey.animeSetBangumiUserId)}
									</p>
								</div>
							) : len > 0 ? (
								<div
									id="anime-list-container"
									class={`anime-grid-container grid gap-4 md:gap-6 opacity-0 transition-opacity duration-300`}
								>
									{animeList.map((anime, i) => {
										const statusInfo = getStatusInfo(anime.status);
										const progressPercent =
											anime.totalEpisodes > 0
												? (anime.progress / anime.totalEpisodes) *
													100
												: 0;

										return (
											<div
												class:list={[
													"group relative bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-[var(--radius-large)] overflow-hidden hover:shadow-lg dark:hover:shadow-white/30 transition-shadow duration-300",
													i >= PAGE_SIZE && "anime-hidden",
												]}
												data-anime-status={anime.status}
											>
												<div class="relative anime-cover-container aspect-[2/3] overflow-hidden">
													<a
														href={anime.link}
														target="_blank"
														rel="noopener noreferrer"
														class="block w-full h-full"
													>
														<ImageWrapper
															src={anime.cover}
															alt={anime.title}
															class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
														/>
														<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
															<div class="absolute inset-0 flex items-center justify-center">
																<div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center">
																	<svg
																		class="w-6 h-6 text-gray-800 ml-1"
																		fill="currentColor"
																		viewBox="0 0 24 24"
																	>
																		<path d="M8 5v14l11-7z" />
																	</svg>
																</div>
															</div>
														</div>
													</a>

													<div
														class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
													>
														<span class="mr-1">
															{statusInfo.icon}
														</span>
														<span>{statusInfo.text}</span>
													</div>

													<div class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1">
														<svg
															class="w-3 h-3 text-yellow-400"
															fill="currentColor"
															viewBox="0 0 20 20"
														>
															<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
														</svg>
														<span>{anime.rating}</span>
													</div>

													{anime.status === "watching" && (
														<div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
															<div class="w-full bg-white/20 rounded-full h-1.5 mb-1">
																<div
																	class="bg-gradient-to-r from-emerald-400 to-teal-400 h-1.5 rounded-full transition-all duration-300"
																	style={`width: ${progressPercent}%`}
																/>
															</div>
															<div class="text-white text-xs font-medium">
																{anime.progress}/
																{anime.totalEpisodes} (
																{Math.round(
																	progressPercent,
																)}
																%)
															</div>
														</div>
													)}
												</div>

												<div class="p-3">
													<h2 class="ignore text-sm font-bold text-black/90 dark:text-white/90 mb-1 leading-tight">
														{anime.title}
													</h2>
													<p
														class="text-black/60 dark:text-white/60 text-xs mb-2 line-clamp-2"
														title={anime.description}
													>
														{anime.description}
													</p>

													<div class="space-y-1 text-xs">
														<div class="flex justify-between items-center">
															<span class="text-black/50 dark:text-white/50 shrink-0">
																{i18n(
																	I18nKey.animeYear,
																)}
															</span>
															<span class="text-black/70 dark:text-white/70 truncate ml-2 text-right">
																{anime.year}
															</span>
														</div>
														<div class="flex justify-between items-start">
															<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
																{i18n(
																	I18nKey.animeStudio,
																)}
															</span>
															<span
																class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 break-words"
																title={anime.studio}
															>
																{anime.studio}
															</span>
														</div>
														<div class="flex flex-wrap gap-1 mt-2">
															{anime.genre.map((g) => (
																<span class="px-2 py-1 text-xs bg-[oklch(0.95_0.025_var(--hue))] text-[oklch(0.55_0.12_var(--hue))] dark:bg-[oklch(0.33_0.035_var(--hue))] dark:text-neutral-300 rounded-md">
																	{g}
																</span>
															))}
														</div>
													</div>
												</div>
											</div>
										);
									})}
								</div>
							) : (
								<div class="text-center py-12">
									<Icon
										name="material-symbols:sentiment-sad-outline"
										class="w-12 h-12 mb-4 mx-auto block text-[var(--primary)]"
									/>
									<h3 class="text-xl font-bold text-black/80 dark:text-white/80 mb-2">
										{i18n(I18nKey.animeEmpty)}
									</h3>
									<p class="text-black/60 dark:text-white/60">
										{ANIME_MODE === "local"
											? i18n(I18nKey.animeEmptyLocal)
											: ANIME_MODE === "bilibili"
												? i18n(I18nKey.animeEmptyBilibili)
												: i18n(I18nKey.animeEmptyBangumi)}
									</p>
								</div>
							)
						}

						{
							len > 0 && (
								<div
									id="anime-filter-empty"
									class="text-center py-12"
									style="display: none"
								>
									<Icon
										name="material-symbols:search"
										class="w-12 h-12 mb-4 mx-auto block text-[var(--primary)]"
									/>
									<h2 class="text-xl font-bold text-black/80 dark:text-white/80 mb-2">
										{i18n(I18nKey.animeFilterEmpty)}
									</h2>
								</div>
							)
						}
					</div>
				</div>
			</div>

			{
				len > 0 && (
					<div
						id="anime-pagination"
						class="mt-4 mx-auto flex flex-row gap-3 justify-center flex-shrink-0 onload-animation"
						style={`animation-delay: calc(var(--content-delay) + ${Math.min(len, 10) * 50}ms)`}
					>
						<button
							id="anime-prev-btn"
							aria-label="Previous Page"
							class="btn-card overflow-hidden rounded-lg text-[var(--primary)] w-11 h-11 disabled opacity-50 cursor-not-allowed"
							disabled
						>
							<Icon
								name="material-symbols:chevron-left-rounded"
								class="text-[1.75rem]"
							/>
						</button>
						<div
							id="anime-page-numbers"
							class="bg-[var(--card-bg)] flex flex-row rounded-lg items-center text-neutral-700 dark:text-neutral-300 font-bold"
						>
							<div class="h-11 w-11 rounded-lg bg-[var(--primary)] flex items-center justify-center font-bold text-white dark:text-black/70">
								1
							</div>
						</div>
						<button
							id="anime-next-btn"
							aria-label="Next Page"
							class="btn-card overflow-hidden rounded-lg text-[var(--primary)] w-11 h-11 disabled opacity-50 cursor-not-allowed"
							disabled
						>
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="text-[1.75rem]"
							/>
						</button>
					</div>
				)
			}

			<script is:inline define:vars={{ isBothSidebarMode }}>
				(function () {
					function initAnimeLayout() {
						const animeListContainer = document.getElementById(
							"anime-list-container",
						);
						if (!animeListContainer) return false;
						const mainGrid = document.getElementById("main-grid");
						const defaultLayoutMode = mainGrid
							? mainGrid.getAttribute("data-layout-mode")
							: "list";
						const currentLayout =
							localStorage.getItem("postListLayout") || defaultLayoutMode;
						updateAnimeListLayout(currentLayout, false);
						requestAnimationFrame(() => {
							animeListContainer.classList.remove("opacity-0");
						});
						return true;
					}

					let retryCount = 0;
					const maxRetries = 10;
					function tryInit() {
						if (initAnimeLayout()) return;
						if (retryCount < maxRetries) {
							retryCount++;
							const delay = Math.min(
								100 * Math.pow(1.5, retryCount),
								1000,
							);
							setTimeout(tryInit, delay);
						} else {
							setTimeout(() => {
								const animeListContainer = document.getElementById(
									"anime-list-container",
								);
								if (animeListContainer) {
									const mainGrid =
										document.getElementById("main-grid");
									const defaultLayoutMode = mainGrid
										? mainGrid.getAttribute("data-layout-mode")
										: "list";
									const currentLayout =
										localStorage.getItem("postListLayout") ||
										defaultLayoutMode;
									updateAnimeListLayout(currentLayout, false);
									animeListContainer.classList.remove("opacity-0");
								}
							}, 2000);
						}
					}

					if (document.readyState === "loading") {
						document.addEventListener("DOMContentLoaded", tryInit);
					} else {
						tryInit();
					}

					function updateAnimeListLayout(layout, shouldAnimate = true) {
						const animeListContainer = document.getElementById(
							"anime-list-container",
						);
						if (!animeListContainer) return;
						animeListContainer.dataset.currentLayout = layout;

						const animeItems = Array.from(
							document.querySelectorAll("[data-anime-status]"),
						);
						const visibleItems = animeItems.filter(
							(item) => item.offsetParent !== null,
						);
						const firstPositions = new Map();
						if (shouldAnimate) {
							visibleItems.forEach((item) => {
								const rect = item.getBoundingClientRect();
								firstPositions.set(item, {
									left: rect.left,
									top: rect.top,
									width: rect.width,
									height: rect.height,
								});
							});
						}

						const style = document.createElement("style");
						style.innerHTML = `.anime-grid-container .group { transition: none !important; }`;
						document.head.appendChild(style);
						animeListContainer.classList.remove(
							"anime-list-mode",
							"anime-grid-mode",
						);
						animeListContainer.classList.remove(
							"grid-cols-1",
							"md:grid-cols-2",
							"lg:grid-cols-3",
						);

						if (layout === "grid") {
							animeListContainer.classList.add("anime-grid-mode");
							const rightSidebar = document.querySelector(
								".right-sidebar-container",
							);
							if (rightSidebar) {
								rightSidebar.classList.add("hidden-in-grid-mode");
								if (window.innerWidth >= 1280) {
									rightSidebar.style.display = "none";
								}
							}
							const mainGrid = document.getElementById("main-grid");
							if (mainGrid) {
								if (window.innerWidth >= 1280) {
									mainGrid.style.gridTemplateColumns = "17.5rem 1fr";
								}
								mainGrid.classList.add("two-column-layout");
							}
						} else {
							animeListContainer.classList.add("anime-list-mode");
							animeListContainer.classList.add(
								"grid-cols-1",
								"lg:grid-cols-2",
							);
							const rightSidebar = document.querySelector(
								".right-sidebar-container",
							);
							if (rightSidebar) {
								rightSidebar.classList.remove("hidden-in-grid-mode");
								rightSidebar.style.display = "";
								rightSidebar.style.removeProperty("display");
							}
							const mainGrid = document.getElementById("main-grid");
							if (mainGrid) {
								if (window.innerWidth >= 1280) {
									mainGrid.style.gridTemplateColumns = "";
								}
								mainGrid.classList.remove("two-column-layout");
								mainGrid.removeAttribute("data-layout-mode");
							}
						}

						void animeListContainer.offsetHeight;
						if (!shouldAnimate) {
							if (style.parentNode) style.parentNode.removeChild(style);
							return;
						}

						requestAnimationFrame(() => {
							if (style.parentNode) style.parentNode.removeChild(style);

							visibleItems.forEach((item) => {
								const first = firstPositions.get(item);
								if (!first) return;
								const last = item.getBoundingClientRect();

								const deltaX = Math.round(first.left - last.left);
								const deltaY = Math.round(first.top - last.top);
								const deltaW = first.width / last.width;
								const deltaH = first.height / last.height;

								if (
									Math.abs(deltaX) < 1 &&
									Math.abs(deltaY) < 1 &&
									Math.abs(deltaW - 1) < 0.01 &&
									Math.abs(deltaH - 1) < 0.01
								)
									return;

								item.style.willChange = "transform";
								item.style.transition = "none";
								item.style.transformOrigin = "top left";
								item.style.transform = `translate(${deltaX}px, ${deltaY}px) scale(${deltaW}, ${deltaH})`;
							});

							void animeListContainer.offsetHeight;
							requestAnimationFrame(() => {
								visibleItems.forEach((item) => {
									item.style.transition =
										"transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1)";
									item.style.transform = "";
								});
								setTimeout(() => {
									visibleItems.forEach((item) => {
										item.style.transition = "";
										item.style.transformOrigin = "";
										item.style.transform = "";
										item.style.willChange = "";
									});
								}, 500);
							});
						});
					}

					window.addEventListener("layoutChange", (event) => {
						updateAnimeListLayout(event.detail.layout);
					});

					function setupSwupListeners() {
						if (window.swup) {
							window.swup.hooks.on("content:replace", () => {
								setTimeout(() => {
									const animeListContainer = document.getElementById(
										"anime-list-container",
									);
									if (animeListContainer) {
										const mainGrid =
											document.getElementById("main-grid");
										const defaultLayoutMode = mainGrid
											? mainGrid.getAttribute("data-layout-mode")
											: "list";
										const currentLayout =
											localStorage.getItem("postListLayout") ||
											defaultLayoutMode;
										updateAnimeListLayout(currentLayout, false);
									}
								}, 100);
							});
						}
					}

					if (typeof window !== "undefined") {
						if (window.swup) {
							setupSwupListeners();
						} else {
							document.addEventListener(
								"swup:enable",
								setupSwupListeners,
							);
						}
					}
				})();
			</script>

			<script is:inline define:vars={{ pageSize: PAGE_SIZE }}>
				(function () {
					// 统一状态机：筛选 + 分页都操作同一份全量 DOM 列表
					let currentStatus = "all";
					let currentPage = 1;
					let applyToken = 0;

					// 翻页后定位内容区：全屏横幅模式下跳过 banner 定位到主内容（与 main-grid.js 全站约定一致）
					function scrollToContentTop() {
						const defaultWallpaperMode =
							JSON.parse(
								document.documentElement.dataset.mainGridConfig ||
									"{}",
							).defaultWallpaperMode || "banner";
						const wallpaperMode =
							localStorage.getItem("wallpaperMode") ||
							defaultWallpaperMode;
						if (
							window.innerWidth >= 1280 &&
							wallpaperMode === "fullscreen-banner"
						) {
							const mainPanel = document.querySelector(
								".absolute.w-full.z-30.pointer-events-none",
							);
							if (mainPanel) {
								const targetY = Math.max(
									0,
									mainPanel.getBoundingClientRect().top +
										window.scrollY -
										60,
								);
								window.scrollTo({
									top: targetY,
									behavior: "smooth",
								});
								return;
							}
						}
						window.scrollTo({ top: 0, behavior: "smooth" });
					}

					function bindOnce(el, type, handler) {
						if (!el) return;
						const key = `animeBound${type}`;
						if (el.dataset[key] === "1") return;
						el.dataset[key] = "1";
						el.addEventListener(type, handler);
					}

					function getAllItems() {
						return Array.from(
							document.querySelectorAll(
								"#anime-list-container [data-anime-status]",
							),
						);
					}

					function getFilteredItems() {
						const items = getAllItems();
						if (currentStatus === "all") return items;
						return items.filter(
							(item) =>
								item.getAttribute("data-anime-status") === currentStatus,
						);
					}

					function getTotalPages(filtered) {
						return Math.max(1, Math.ceil(filtered.length / pageSize));
					}

					function renderPagination(totalFiltered, totalPages) {
						const container = document.getElementById("anime-pagination");
						const numbers = document.getElementById("anime-page-numbers");
						const prevBtn = document.getElementById("anime-prev-btn");
						const nextBtn = document.getElementById("anime-next-btn");
						if (!container || !numbers || !prevBtn || !nextBtn) return;

						container.style.display = totalFiltered === 0 ? "none" : "";

						if (currentPage > 1) {
							prevBtn.disabled = false;
							prevBtn.classList.remove(
								"disabled",
								"opacity-50",
								"cursor-not-allowed",
							);
						} else {
							prevBtn.disabled = true;
							prevBtn.classList.add(
								"disabled",
								"opacity-50",
								"cursor-not-allowed",
							);
						}
						if (currentPage < totalPages) {
							nextBtn.disabled = false;
							nextBtn.classList.remove(
								"disabled",
								"opacity-50",
								"cursor-not-allowed",
							);
						} else {
							nextBtn.disabled = true;
							nextBtn.classList.add(
								"disabled",
								"opacity-50",
								"cursor-not-allowed",
							);
						}

						// 页码窗口算法（与全站 Pagination 组件一致）
						const HIDDEN = -1;
						const ADJ_DIST = 2;
						const VISIBLE = ADJ_DIST * 2 + 1;
						let count = 1;
						let l = currentPage;
						let r = currentPage;
						while (0 < l - 1 && r + 1 <= totalPages && count + 2 <= VISIBLE) {
							count += 2;
							l--;
							r++;
						}
						while (0 < l - 1 && count < VISIBLE) {
							count++;
							l--;
						}
						while (r + 1 <= totalPages && count < VISIBLE) {
							count++;
							r++;
						}

						let pages = [];
						if (l > 1) pages.push(1);
						if (l === 3) pages.push(2);
						if (l > 3) pages.push(HIDDEN);
						for (let i = l; i <= r; i++) pages.push(i);
						if (r < totalPages - 2) pages.push(HIDDEN);
						if (r === totalPages - 2) pages.push(totalPages - 1);
						if (r < totalPages) pages.push(totalPages);

						numbers.innerHTML = pages
							.map((p) => {
								if (p === HIDDEN) {
									return `<svg class="mx-1 w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>`;
								}
								if (p === currentPage) {
									return `<div class="h-11 w-11 rounded-lg bg-[var(--primary)] flex items-center justify-center font-bold text-white dark:text-black/70">${p}</div>`;
								}
								return `<button data-page="${p}" class="anime-page-num-btn btn-card w-11 h-11 rounded-lg overflow-hidden active:scale-[0.85]">${p}</button>`;
							})
							.join("");

						numbers.querySelectorAll(".anime-page-num-btn").forEach(
							(btn) => {
								btn.addEventListener("click", function () {
									const target = parseInt(this.dataset.page, 10);
									if (target === currentPage) return;
									currentPage = target;
									applyView();
									scrollToContentTop();
								});
							},
						);
					}

					function applyView(shouldAnimate = true) {
						const container = document.getElementById(
							"anime-list-container",
						);
						if (!container) return;

						const filtered = getFilteredItems();
						const totalPages = getTotalPages(filtered);
						currentPage = Math.min(Math.max(1, currentPage), totalPages);
						const start = (currentPage - 1) * pageSize;
						const shownSet = new Set(
							filtered.slice(start, start + pageSize),
						);

						const itemsToShow = [];
						const itemsToHide = [];
						const itemsToKeep = [];
						getAllItems().forEach((item) => {
							const shouldShow = shownSet.has(item);
							const isCurrentlyVisible =
								!item.classList.contains("anime-hidden");
							if (shouldShow) {
								isCurrentlyVisible
									? itemsToKeep.push(item)
									: itemsToShow.push(item);
							} else if (isCurrentlyVisible) {
								itemsToHide.push(item);
							}
						});

						const emptyTip = document.getElementById("anime-filter-empty");
						if (emptyTip) {
							emptyTip.style.display =
								filtered.length === 0 ? "" : "none";
						}

						renderPagination(filtered.length, totalPages);

						if (
							!shouldAnimate ||
							(itemsToHide.length === 0 &&
								itemsToShow.length === 0 &&
								itemsToKeep.length === 0)
						) {
							itemsToHide.forEach((item) => {
								item.classList.add("anime-hidden");
								item.classList.remove("anime-fade-out");
							});
							itemsToShow.forEach((item) => {
								item.classList.remove("anime-hidden");
							});
							return;
						}

						const token = ++applyToken;

						// 保留项 FLIP 位移基线
						const firstPositions = new Map();
						itemsToKeep.forEach((item) => {
							const rect = item.getBoundingClientRect();
							firstPositions.set(item, {
								left: rect.left,
								top: rect.top,
							});
						});

						const runAnimation = () => {
							if (token !== applyToken) return;
							itemsToHide.forEach((item) => {
								item.classList.add("anime-hidden");
								item.classList.remove("anime-fade-out");
							});
							itemsToShow.forEach((item) => {
								item.classList.remove("anime-hidden");
								item.classList.add("anime-fade-in");
								item.style.transition = "none";
							});
							itemsToKeep.forEach((item) => {
								const first = firstPositions.get(item);
								if (!first) return;
								const rect = item.getBoundingClientRect();
								const deltaX = Math.round(first.left - rect.left);
								const deltaY = Math.round(first.top - rect.top);
								if (deltaX !== 0 || deltaY !== 0) {
									item.style.willChange = "transform";
									item.style.transition = "none";
									item.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
								}
							});
							requestAnimationFrame(() => {
								if (token !== applyToken) return;
								itemsToKeep.forEach((item) => {
									item.style.transition =
										"transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
									item.style.transform = "";
								});
								const STAGGER_LIMIT = 20;
								itemsToShow.forEach((item, index) => {
									item.style.transition = "";
									item.style.willChange = "opacity, transform";
									const delay = index < STAGGER_LIMIT ? index * 30 : 0;
									item.style.transitionDelay = `${delay}ms`;
									requestAnimationFrame(() => {
										item.classList.remove("anime-fade-in");
										item.classList.add("anime-fade-in-active");
									});
								});
								setTimeout(
									() => {
										[...itemsToKeep, ...itemsToShow].forEach(
											(item) => {
												item.classList.remove(
													"anime-fade-in-active",
												);
												item.style.transition = "";
												item.style.transform = "";
												item.style.opacity = "";
												item.style.willChange = "";
												item.style.transitionDelay = "";
											},
										);
									},
									600 +
										(itemsToShow.length > 0
											? Math.min(itemsToShow.length, 20) * 30
											: 0),
								);
							});
						};

						if (itemsToHide.length > 0) {
							itemsToHide.forEach((item) =>
								item.classList.add("anime-fade-out"),
							);
							setTimeout(() => {
								if (token === applyToken) runAnimation();
							}, 200);
						} else {
							runAnimation();
						}
					}

					function initAnimePage() {
						const container = document.getElementById(
							"anime-list-container",
						);
						if (!container) return;
						currentStatus = "all";
						currentPage = 1;

						document.querySelectorAll(".anime-filter-tag").forEach(
							(tag) => {
								bindOnce(tag, "click", function () {
									if (this.classList.contains("anime-active")) return;
									document
										.querySelectorAll(".anime-filter-tag")
										.forEach((t) => t.classList.remove("anime-active"));
									this.classList.add("anime-active");
									currentStatus =
										this.getAttribute("data-status") || "all";
									currentPage = 1;
									applyView();
								});
							},
						);

						const prevBtn = document.getElementById("anime-prev-btn");
						if (prevBtn) {
							bindOnce(prevBtn, "click", () => {
								if (currentPage > 1) {
									currentPage--;
									applyView();
									scrollToContentTop();
								}
							});
						}
						const nextBtn = document.getElementById("anime-next-btn");
						if (nextBtn) {
							bindOnce(nextBtn, "click", () => {
								const totalPages = getTotalPages(getFilteredItems());
								if (currentPage < totalPages) {
									currentPage++;
									applyView();
									scrollToContentTop();
								}
							});
						}

						applyView(false);
					}

					if (document.readyState === "loading") {
						document.addEventListener("DOMContentLoaded", initAnimePage);
					} else {
						initAnimePage();
					}

					function setupSwupListeners() {
						if (window.swup) {
							window.swup.hooks.on("content:replace", () =>
								setTimeout(initAnimePage, 150),
							);
						}
					}

					if (typeof window !== "undefined") {
						if (window.swup) {
							setupSwupListeners();
						} else {
							document.addEventListener("swup:enable", setupSwupListeners);
						}
					}
				})();
			</script>
		</MainGridLayout>
	)
}