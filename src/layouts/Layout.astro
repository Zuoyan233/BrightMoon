---
import AnalyticsScripts from "@components/AnalyticsScripts.astro";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import CookieConsent from "@components/CookieConsent.astro";
import ExternalLinkConfirm from "@components/ExternalLinkConfirm.astro";
import ProgressBar from "@components/ProgressBar.svelte";
import Pio from "@components/widget/Pio.svelte"; // 使用 Svelte 版本的 Pio 组件
import {
	externalLinkConfirmConfig,
	pioConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import { umamiConfig } from "../config";
import themeInitRaw from "../scripts/theme-init.js?raw";

const BANNER_HEIGHT = 35;
const BANNER_HEIGHT_EXTEND = 30;
const BANNER_HEIGHT_HOME = BANNER_HEIGHT + BANNER_HEIGHT_EXTEND;
const BANNER_HEIGHT_FULLSCREEN = 100;

import { PAGE_WIDTH } from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "../styles/mobile-navbar.css";
import "../styles/wallpaper-navbar-transparent.css";
import "../styles/fancybox-custom.css";
import "../styles/expressive-code.css";
import "../styles/panel-animations.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
}

let { title, banner, description, lang, setOGTypeArticle, postSlug } =
	Astro.props;

// 判断是否为首页
// 用于动态调整banner高度
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const defaultWallpaperMode = siteConfig.appearance.wallpaperMode.defaultMode;
const isFullscreenBannerDefault = defaultWallpaperMode === "fullscreen-banner";

// 获取配置中的hue值
const configHue = siteConfig.appearance.hue;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	siteConfig.appearance?.navbar?.transparentMode || "semi";

// 判断是否应该显示顶部高光效果（只在full和semifull模式下显示）
const shouldShowTopHighlight =
	navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

// 获取默认banner图片的辅助函数
const getDefaultBanner = (): string => {
	const src = siteConfig.banner.src;
	if (typeof src === "string") {
		return src;
	}
	if (Array.isArray(src)) {
		return src[0] || "";
	}
	if (src && typeof src === "object") {
		// 优先使用desktop，如果没有则使用mobile
		const desktopSrc = src.desktop;
		const mobileSrc = src.mobile;
		if (typeof desktopSrc === "string") {
			return desktopSrc;
		}
		if (Array.isArray(desktopSrc) && desktopSrc.length > 0) {
			return desktopSrc[0];
		}
		if (typeof mobileSrc === "string") {
			return mobileSrc;
		}
		if (Array.isArray(mobileSrc) && mobileSrc.length > 0) {
			return mobileSrc[0];
		}
	}
	return "";
};

if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = getDefaultBanner();
}

// 如果 banner 为空，使用默认 banner
banner = getDefaultBanner();

// 判断是否应该显示banner
const enableBanner = !!siteConfig.banner.src;

// 构建页面标题
let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

// 构建 Open Graph 图片 URL
let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
}

// 构建 favicon 配置
const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// 构建语言配置
if (!lang) {
	lang = `${siteConfig.lang}`;
}

// 替换语言配置中的下划线为短横线
const siteLang = lang.replace("_", "-");

// 构建 banner 偏移量配置
const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};

// 获取默认 banner 偏移量
const bannerOffset =
	bannerOffsetByPosition[
		siteConfig.appearance.wallpaperMode.defaultBannerPosition || "center"
	];

// 判断是否应该启用 Umami 分析
// 用于在页面底部插入 Umami 分析脚本
const umamiEnabled = umamiConfig.enabled || false;
const umamiScripts = umamiConfig.scripts || ""; // 获取Umami scripts配置

// 构建字体配置的 CSS 变量
let bodyFontFamily = "";
let fontFaceStyle = "";
if (siteConfig.font?.fontFamily) {
	const font = siteConfig.font.fontFamily;
	// 如果字体名包含空格，需要用引号包围
	bodyFontFamily = font.includes(" ") ? `"${font}"` : font;
	// 添加系统字体作为最终回退
	bodyFontFamily +=
		", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif";

	// 动态生成 @font-face 样式
	if (siteConfig.font.fontFile) {
		const fontWeight = siteConfig.font.fontWeight || "500";
		fontFaceStyle = `
<style>
@font-face {
  font-family: "${font}";
  src: url("${siteConfig.font.fontFile}") format("woff2");
  font-style: normal;
  font-weight: ${fontWeight};
  font-display: swap;
}
</style>`;
	}
}
---

<!-- 页面布局 --><!doctype html>
<html
	lang={siteLang}
	class="bg-[var(--page-bg)] text-[14px] md:text-[16px]"
	data-config-hue={configHue}
	data-page-scaling={JSON.stringify(siteConfig.pageScaling || {})}
	data-main-grid-config={JSON.stringify({
		navbarTransparentMode:
			siteConfig.appearance?.navbar?.transparentMode || "semi",
		defaultWallpaperMode: siteConfig.appearance.wallpaperMode.defaultMode,
		defaultBannerPosition:
			siteConfig.appearance.wallpaperMode.defaultBannerPosition ||
			"center",
		defaultPostListLayout:
			siteConfig.appearance.postListLayout?.defaultMode || "list",
		BANNER_HEIGHT: BANNER_HEIGHT,
		BANNER_HEIGHT_FULLSCREEN: BANNER_HEIGHT_FULLSCREEN,
		responsiveTocModes: {
			mobile: siteConfig.toc.responsive?.mobile || "float",
			tablet: siteConfig.toc.responsive?.tablet || "float",
			desktop: siteConfig.toc.responsive?.desktop || "sidebar",
		},
	})}
>
	<head>
		<meta charset="UTF-8" />

		<!-- 动态字体引入 -->
		<Fragment set:html={fontFaceStyle} />

		<!-- 字体预加载：提前发起请求，避免 FOIT 和 LCP 延迟 -->
		{
			siteConfig.font?.fontFile && (
				<link
					rel="preload"
					href={siteConfig.font.fontFile}
					as="font"
					type="font/woff2"
					crossorigin="anonymous"
				/>
			)
		}

		<!-- 页面标题 -->
		<title>{pageTitle}</title>
		<meta name="description" content={description || pageTitle} />
		{
			siteConfig.keywords && siteConfig.keywords.length > 0 && (
				<meta
					name="keywords"
					content={siteConfig.keywords.join(", ")}
				/>
			)
		}

		<!-- 页面作者 -->
		<meta name="author" content={profileConfig.name} />
		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || pageTitle} />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		{
			setOGTypeArticle ? (
				<meta property="og:type" content="article" />
			) : (
				<meta property="og:type" content="website" />
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description || pageTitle} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{
			favicons.map((favicon) => (
				<link
					rel="icon"
					href={
						favicon.src.startsWith("/")
							? url(favicon.src)
							: favicon.src
					}
					sizes={favicon.sizes}
					media={
						favicon.theme &&
						`(prefers-color-scheme: ${favicon.theme})`
					}
				/>
			))
		}

		<!-- 页面主题初始化脚本 - 用于在页面渲染前设置主题 -->
		<script is:inline set:html={themeInitRaw} />
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>

		<!-- 自定义头内容 -->
		<slot name="head" />

		<!-- Pio 看板娘样式 - 仅在启用时加载 -->
		{
			pioConfig.enable && (
				<link rel="stylesheet" href="/pio/static/pio.css" />
			)
		}

		<!-- 第三方分析脚本 -->
		<AnalyticsScripts
			thirdPartyAnalytics={siteConfig.thirdPartyAnalytics}
		/>

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>

		<!-- Umami 分析脚本 -->
		{umamiEnabled && umamiScripts && <Fragment set:html={umamiScripts} />}
	</head>
	<body
		class="min-h-screen"
		class:list={[
			{
				"lg:is-home": isHomePage,
				"enable-banner": enableBanner,
				"fullscreen-banner": isFullscreenBannerDefault,
			},
			{
				"hide-translate-select":
					siteConfig.translate?.enable &&
					siteConfig.translate?.showSelectTag === false,
			},
		]}
		data-is-home={isHomePage}
		style={bodyFontFamily ? `font-family: ${bodyFontFamily};` : ""}
	>
		<!-- 顶部加载条 -->
		{
			siteConfig.progressBar?.enable !== false &&
				siteConfig.progressBar?.fadeDuration != null && (
					<ProgressBar
						fadeDuration={siteConfig.progressBar.fadeDuration}
						client:idle
					/>
				)
		}

		<!-- 页面顶部渐变高光效果 - 只在full和semifull模式下显示 -->
		{shouldShowTopHighlight && <div class="top-gradient-highlight" />}

		<ConfigCarrier />
		<slot />

		<!-- Pio 看板娘组件 - 仅在启用时加载 -->
		{pioConfig.enable && <Pio client:idle />}

		<!-- 外部链接确认组件 -->
		{
			externalLinkConfirmConfig.enable && (
				<ExternalLinkConfirm {...externalLinkConfirmConfig} />
			)
		}

		<!-- Cookie 隐私提示栏 -->
		<CookieConsent enable={siteConfig.cookieConsent?.enable ?? true} />

		<!-- 页面高度扩展元素：用于在页面过渡时防止滚动动画跳跃 -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
		"banner-height-fullscreen": `${BANNER_HEIGHT_FULLSCREEN}vh`,
	}}
>
	@tailwind components;
	@layer components {
		.enable-banner[data-is-home="true"] #banner-wrapper {
			@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)];
		}
		.enable-banner #banner-wrapper {
			@apply h-[var(--banner-height-home)];
		}
		/* 全屏横幅模式：banner 占满整个视口 */
		.enable-banner.fullscreen-banner[data-is-home="true"] #banner-wrapper,
		.enable-banner.fullscreen-banner #banner-wrapper {
			@apply h-[var(--banner-height-fullscreen)] translate-y-0;
		}
		.enable-banner[data-is-home="true"] #banner {
			@apply h-[var(--banner-height-home)] translate-y-0;
		}
		.enable-banner #banner {
			@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)];
		}
		.enable-banner.fullscreen-banner[data-is-home="true"] #banner,
		.enable-banner.fullscreen-banner #banner {
			@apply h-[var(--banner-height-fullscreen)] translate-y-0;
		}
		.enable-banner[data-is-home="true"] #main-grid {
			@apply translate-y-[var(--banner-height-extend)];
		}
		/* 全屏横幅模式下主网格不需要额外下移 */
		.enable-banner.fullscreen-banner[data-is-home="true"] #main-grid {
			@apply translate-y-0;
		}
		/* 壁纸模式切换过渡：banner 高度/位移、内层 banner、sticky 侧边栏统一 700ms，与主内容 top / main-grid 位移保持同步 */
		.enable-banner #banner-wrapper,
		.enable-banner #banner,
		.enable-banner #sidebar-sticky,
		.enable-banner #right-sidebar-sticky {
			transition-property: height, top, transform, opacity;
			transition-duration: 0.7s;
			transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		}
		.enable-banner #top-row {
			@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300;
		}
		.enable-banner[data-is-home="true"] #sidebar-sticky {
			@apply top-[calc(1rem_-_var(--banner-height-extend))];
		}
		.enable-banner[data-is-home="true"] #right-sidebar-sticky {
			@apply top-[calc(1rem_-_var(--banner-height-extend))];
		}
		/* 全屏横幅模式下侧边栏 sticky 位置恢复为 1rem */
		.enable-banner.fullscreen-banner[data-is-home="true"] #sidebar-sticky,
		.enable-banner.fullscreen-banner[data-is-home="true"]
			#right-sidebar-sticky {
			@apply top-4;
		}
		.navbar-hidden {
			@apply opacity-0 -translate-y-16;
		}

		/* 水波动画 */
		.waves > .parallax use {
			animation: wave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
		}
		@keyframes wave {
			0% {
				transform: translate3d(-90px, 0, 0);
			}
			100% {
				transform: translate3d(85px, 0, 0);
			}
		}

		/* 水波动画性能模式 -减少动画复杂度 */
		.waves-performance-mode svg .parallax use:nth-child(3),
		.waves-performance-mode svg .parallax use:nth-child(4) {
			display: none;
		}
		.waves-performance-mode svg .parallax use {
			animation-duration: 15s !important;
		}

		/* 当配置 showSelectTag 为 false 时，隐藏 translate.js 默认的语言选择下拉框 */
		.hide-translate-select #translateSelectLanguage,
		.hide-translate-select #translate {
			display: none !important;
		}

		/* translate.js 默认语言选择框定位 */
		#translate {
			position: fixed;
			top: 5rem;
			right: 1rem;
			z-index: 40;
		}

		/* 鼠标未悬停时，5秒后变淡 */
		#translate:not(:hover) {
			animation: fadeOut 5s forwards;
		}

		@keyframes fadeOut {
			0% {
				opacity: 1;
			}
			100% {
				opacity: 0.1;
			}
		}
	}
</style>

<script>
	import "../scripts/layout.js";
</script>
