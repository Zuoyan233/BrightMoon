---
import Breadcrumb from "@components/Breadcrumb.astro";
import BackToTop from "@components/control/BackToTop.astro";
import FloatingTOC from "@components/control/FloatingTOC.astro";
import Footer from "@components/Footer.astro";
import RightSideBar from "@components/layout/RightSideBar.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedPostsList } from "@utils/content-utils";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import { LinkPreset } from "@/types/config";
import FullscreenWallpaper from "../components/misc/FullscreenWallpaper.astro";
import IconifyLoader from "../components/misc/IconifyLoader.astro";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TypewriterText from "../components/TypewriterText.astro";
import { sidebarLayoutConfig, siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_FULLSCREEN,
	// BANNER_HEIGHT_HOME,
	// MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import { LinkPresets } from "../constants/link-presets";
import { widgetManager } from "../utils/widget-manager";
import Layout from "./Layout.astro";

interface BreadcrumbItem {
	label: string;
	href?: string;
	icon?: string;
	suggestionLabel?: string;
}

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	headings?: MarkdownHeading[];
	breadcrumbItems?: BreadcrumbItem[];
}

// 获取 TOC 响应式模式配置
const getDeviceType = () => {
	return {
		mobile: siteConfig.toc.responsive?.mobile || "float",
		tablet: siteConfig.toc.responsive?.tablet || "float",
		desktop: siteConfig.toc.responsive?.desktop || "sidebar",
	};
};

const responsiveTocModes = getDeviceType();

// 类型守卫函数
// const isBannerSrcObject = (
// 	src:
// 		| string
// 		| string[]
// 		| { desktop?: string | string[]; mobile?: string | string[] },
// ): src is { desktop?: string | string[]; mobile?: string | string[] } => {
// 	return (
// 		typeof src === "object" &&
// 		src !== null &&
// 		!Array.isArray(src) &&
// 		("desktop" in src || "mobile" in src)
// 	);
// };

// 获取banner图片的辅助函数
const getBannerImages = async () => {
	let bannerSrc = siteConfig.banner.src;

	// 如果启用了图片API，获取API图片
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());

			if (apiImages.length > 0) {
				bannerSrc = apiImages;
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	if (
		typeof bannerSrc === "object" &&
		bannerSrc !== null &&
		!Array.isArray(bannerSrc) &&
		("desktop" in bannerSrc || "mobile" in bannerSrc)
	) {
		const srcObj = bannerSrc as {
			desktop?: string | string[];
			mobile?: string | string[];
		};
		return {
			desktop: srcObj.desktop || srcObj.mobile || "",
			mobile: srcObj.mobile || srcObj.desktop || "",
		};
	}
	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	return {
		desktop: bannerSrc,
		mobile: bannerSrc,
	};
};

const bannerImages = await getBannerImages();

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	headings = [],
	breadcrumbItems,
} = Astro.props;
const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";
const pathnameClean = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const isPaginatedHome = /^\d+$/.test(pathnameClean);
const showBreadcrumb =
	isHomePage ||
	isPaginatedHome ||
	breadcrumbItems !== undefined ||
	title !== undefined;

// 基于 LinkPresets 的 URL 前缀匹配图标
const urlIconPairs = Object.values(LinkPresets)
	.filter((p) => p.url !== "/")
	.map((p) => ({ url: p.url.replace(/\/+$/, ""), icon: p.icon }))
	.sort((a, b) => b.url.length - a.url.length);

const homeIcon = LinkPresets[LinkPreset.Home].icon;

function matchIconByUrl(path: string): string | undefined {
	if (!path) return undefined;
	const normalized = path.split("?")[0].replace(/\/+$/, "");
	if (normalized === "" || normalized === "/") return homeIcon;
	for (const pair of urlIconPairs) {
		if (normalized === pair.url) return pair.icon;
	}
	for (const pair of urlIconPairs) {
		if (normalized.startsWith(`${pair.url}/`)) return pair.icon;
	}

	// 内容路由回退匹配（不在 LinkPresets 中的动态路由）
	const contentRouteMap: Record<string, string> = {
		"/posts": "material-symbols:article",
	};
	for (const [prefix, icon] of Object.entries(contentRouteMap)) {
		if (normalized === prefix || normalized.startsWith(`${prefix}/`)) {
			return icon;
		}
	}

	// 自定义永久链接 /xxxx/ ，只有一段路径 → 也是文章
	if (
		normalized.split("/").length === 2 &&
		/^[a-z0-9_-]+$/i.test(normalized.slice(1))
	) {
		return "material-symbols:article";
	}

	// 多段路径的回退，如 /category/tech/、/2024/01/ 等
	const segments = normalized.split("/").filter(Boolean);
	if (segments.length >= 2) {
		return "material-symbols:description";
	}

	return undefined;
}

const currentPath = Astro.url.pathname;

// 主页及分页首页时收集所有候选页面/文章，供客户端随机推荐（避免构建时固化）
const homepageCandidatesJson = await (async () => {
	if (!isHomePage && !isPaginatedHome) return "[]";

	// 导航页面（排除首页）
	const navPages = Object.values(LinkPresets).filter((p) => p.url !== "/");

	// 随机选取几篇文章作为候选
	const allPosts = await getSortedPostsList();
	const shuffledPosts = allPosts.sort(() => Math.random() - 0.5).slice(0, 3);
	const postPages = shuffledPosts.map((post) => ({
		label: post.data.title,
		href: post.url || `/posts/${post.id.replace(/\.md$/, "")}/`,
		icon: "material-symbols:article",
	}));

	// 合并导航页面和文章
	const allCandidates = [
		...navPages.map((p) => ({
			suggestionLabel: i18n(I18nKey.suggestion),
			label: p.name,
			href: p.url,
			icon: p.icon,
		})),
		...postPages.map((p) => ({
			suggestionLabel: i18n(I18nKey.suggestion),
			...p,
		})),
	];

	return JSON.stringify(allCandidates);
})();

// 主页及分页首页时不渲染推荐项（由客户端 JS 随机选取并动态插入，避免构建时固化）
const breadcrumbBase =
	breadcrumbItems ||
	(isHomePage || isPaginatedHome ? [] : [{ label: title || "" }]);

const resolvedBreadcrumbItems = breadcrumbBase
	.filter((item) => item.label !== "")
	.map((item) => ({
		...item,
		icon: item.icon || matchIconByUrl(item.href || currentPath),
	}));

const defaultWallpaperMode = siteConfig.appearance.wallpaperMode.defaultMode;
// 首页始终显示 banner 主副标题；全屏横幅模式下非首页也显示，以便进入其他页面时保持文字
const showHomeText =
	siteConfig.banner.homeText?.enable &&
	(isHomePage || defaultWallpaperMode === "fullscreen-banner");

// 全屏横幅模式节日彩蛋：检查今天是否匹配某个节日日期，匹配则覆盖 title / subtitle
function getFestivalOverride() {
	const easterEgg = siteConfig.banner.homeText?.festivalEasterEgg;
	if (!easterEgg?.enable || !easterEgg.dates?.length) return null;
	const now = new Date();
	const today = `${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
	for (const item of easterEgg.dates) {
		let matched = false;
		if (item.startDate) {
			const mmdd = item.startDate.slice(5);
			matched = today === mmdd;
		} else if (item.date) {
			if (item.date.includes("~")) {
				const [start, end] = item.date.split("~");
				matched = today >= start && today <= end;
			} else {
				matched = today === item.date;
			}
		}
		if (matched) {
			let title = item.title;
			if (title?.includes("{years}") && item.startDate) {
				const start = new Date(item.startDate);
				const diff = now.getFullYear() - start.getFullYear();
				const years = diff > 0 ? diff : 1;
				const yearsText = String(years);
				title = title.replace("{years}", yearsText);
			}
			return { ...item, title };
		}
	}
	return null;
}
const festivalOverride = getFestivalOverride();
const homeTextTitle =
	festivalOverride?.title ?? siteConfig.banner.homeText?.title;
const homeTextSubtitle =
	festivalOverride?.subtitle ?? siteConfig.banner.homeText?.subtitle;

// 手机端非首页不显示banner的CSS类
const mobileNonHomeBannerClass = !isHomePage ? "mobile-hide-banner" : "";

// 计算主内容区域位置，考虑手机端非首页时banner被隐藏
// 当默认模式为 banner 时，使用banner高度；fullscreen-banner 时使用全屏banner高度；否则使用顶栏高度
// 让主内容区域紧贴波浪线下方，波浪线高度约为10-15vh，所以主内容从banner顶部开始
const mainPanelTop = (() => {
	const mode = siteConfig.appearance.wallpaperMode.defaultMode;
	if (mode === "banner") return `${BANNER_HEIGHT}vh`;
	if (mode === "fullscreen-banner") return `${BANNER_HEIGHT_FULLSCREEN}vh`;
	return "5.5rem";
})();
// const mobileNonHomeMainTop = !isHomePage ? "5.5rem" : mainPanelTop;

// 当默认模式不是 banner / fullscreen-banner 时，主内容区域应该始终从顶栏下面开始
const finalMainPanelTop = (() => {
	const mode = siteConfig.appearance.wallpaperMode.defaultMode;
	if (mode === "banner" || mode === "fullscreen-banner") return mainPanelTop;
	return "5.5rem";
})();

// 检查侧边栏是否启用，动态调整网格布局
// 响应式配置：不同设备上的侧边栏显示状态
const mobileShowSidebar = widgetManager.shouldShowSidebar("mobile");
const tabletShowSidebar = widgetManager.shouldShowSidebar("tablet");
const desktopShowSidebar = widgetManager.shouldShowSidebar("desktop");

// 检查是否为双侧边栏模式
const isBothSidebarMode = sidebarLayoutConfig.position === "both";

// 检查左侧边栏是否有组件
const hasLeftSidebarComponents = isBothSidebarMode
	? widgetManager.getComponentsByPosition("top", "left").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "left").length > 0
	: widgetManager.getComponentsByPosition("top").length > 0 ||
		widgetManager.getComponentsByPosition("sticky").length > 0;

// 检查右侧边栏是否有组件
const hasRightSidebarComponents =
	isBothSidebarMode &&
	(widgetManager.getComponentsByPosition("top", "right").length > 0 ||
		widgetManager.getComponentsByPosition("sticky", "right").length > 0);

// 桌面端侧边栏最终显示状态（考虑是否有组件）
const desktopShowLeftSidebar = desktopShowSidebar && hasLeftSidebarComponents;
const desktopShowRightSidebar = desktopShowSidebar && hasRightSidebarComponents;

// 平板端侧边栏最终显示状态
const tabletShowLeftSidebar = tabletShowSidebar && hasLeftSidebarComponents;
// 如果左侧有组件，则平板端不显示右侧侧栏；只有当左侧为空且右侧有组件时，才显示右侧侧栏（会被移到左侧）
const tabletShowRightSidebar =
	tabletShowSidebar && hasRightSidebarComponents && !hasLeftSidebarComponents;
const tabletAnySidebar = tabletShowLeftSidebar || tabletShowRightSidebar;

// 检查默认布局模式，如果是 grid 模式，右侧边栏初始就应该隐藏
const defaultPostListLayout =
	siteConfig.appearance.postListLayout?.defaultMode || "list";
const initialRightSidebarHidden = defaultPostListLayout === "grid";

// 动态网格布局类名 - 根据侧边栏模式和是否有组件调整列宽
let desktopGridCols = "lg:grid-cols-1";
if (desktopShowLeftSidebar && desktopShowRightSidebar) {
	desktopGridCols = "lg:grid-cols-[17.5rem_1fr_17.5rem]";
} else if (desktopShowLeftSidebar) {
	desktopGridCols = "lg:grid-cols-[17.5rem_1fr]";
} else if (desktopShowRightSidebar) {
	desktopGridCols = "lg:grid-cols-[1fr_17.5rem]";
}

const gridCols = `
	${mobileShowSidebar ? "grid-cols-1" : "grid-cols-1"}
	${tabletAnySidebar ? "md:grid-cols-[17.5rem_1fr]" : "md:grid-cols-1"}
	${desktopGridCols}
`
	.trim()
	.replace(/\s+/g, " ");

// 侧边栏容器类名 - 始终在左侧
const sidebarClass = `
	onload-animation
	${mobileShowSidebar && hasLeftSidebarComponents ? "block" : "hidden"}
	${tabletShowLeftSidebar ? "md:block md:mb-4 md:max-w-[17.5rem] md:flex-1" : "md:hidden"}
	${desktopShowLeftSidebar ? "lg:block lg:mb-4 lg:row-start-1 lg:row-end-2 lg:max-w-[17.5rem] lg:col-start-1 lg:col-end-2" : "lg:hidden"}
`
	.trim()
	.replace(/\s+/g, " ");

// 右侧边栏容器类名
// 手机端：显示在左侧栏下方（row-start-3），全宽
// 平板端：根据简化逻辑显示（只有当左侧为空时才显示并移到左侧）
// 桌面端：定位到网格最后一列（右侧）
// 如果默认是 grid 模式，初始就隐藏
const rightSidebarClass = `
	onload-animation
	${isBothSidebarMode && mobileShowSidebar && hasRightSidebarComponents ? "block row-start-3 row-end-4 col-span-1" : "hidden"}
	${isBothSidebarMode && tabletShowRightSidebar ? "md:block md:mb-4 md:max-w-[17.5rem]" : "md:hidden"}
	${desktopShowRightSidebar ? `lg:block lg:self-start lg:h-fit lg:mb-4 lg:row-start-1 lg:row-end-2 lg:max-w-[17.5rem] ${desktopShowLeftSidebar ? "lg:col-start-3 lg:col-end-4" : "lg:col-start-2 lg:col-end-3"} lg:col-span-1` : "lg:hidden"}
	${initialRightSidebarHidden ? "hidden-in-grid-mode" : ""}
`
	.trim()
	.replace(/\s+/g, " ");

// 主内容区域类名 - 根据侧边栏模式调整grid-column
// 平板设备和手机端：主内容在最上方row-1，侧边栏在下方
// 桌面端：主内容和侧边栏并排显示
let desktopMainPos = "lg:col-span-1";
if (desktopShowLeftSidebar && desktopShowRightSidebar) {
	desktopMainPos = "lg:col-start-2 lg:col-end-3";
} else if (desktopShowLeftSidebar) {
	desktopMainPos = "lg:col-start-2 lg:col-end-3";
} else if (desktopShowRightSidebar) {
	desktopMainPos = "lg:col-start-1 lg:col-end-2";
}

const mainContentClass = `
	transition-swup-fade overflow-hidden w-full
	col-span-1 row-start-1 row-end-2
	${tabletAnySidebar ? "md:col-start-2 md:col-end-3" : "md:col-start-1 md:col-end-2"}
	${desktopShowSidebar ? desktopMainPos : "lg:col-span-1"}
`
	.trim()
	.replace(/\s+/g, " ");

// 检查是否应该启用半透明效果（当默认模式为 fullscreen 时）
const shouldEnableTransparency =
	siteConfig.appearance.wallpaperMode.defaultMode === "fullscreen";

// 为组件添加半透明效果的CSS类
const transparentClass = shouldEnableTransparency
	? "wallpaper-transparent"
	: "";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug}>

<script>
import "../scripts/main-grid.js";
</script>

<!-- 全屏壁纸 - 始终渲染，通过 JS 控制显示隐藏 -->
<FullscreenWallpaper config={siteConfig.fullscreenWallpaper} />

<!-- 全局图标加载器 -->
<IconifyLoader />

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner - 始终渲染，通过 JS 控制显示隐藏 -->
<!-- 注意：不要在此加 Tailwind 的 transition/duration 工具类，其属性列表不含 height/top 且会覆盖 Layout.astro 中的统一过渡规则，导致模式切换时高度瞬间跳变 -->
<div id="banner-wrapper" class={`absolute z-10 w-full overflow-hidden ${mobileNonHomeBannerClass}`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>

    {siteConfig.banner.carousel?.enable && ((bannerImages.desktop && Array.isArray(bannerImages.desktop) && bannerImages.desktop.length > 1) || (bannerImages.mobile && Array.isArray(bannerImages.mobile) && bannerImages.mobile.length > 1)) ? (
        <div id="banner-carousel" class="relative h-full w-full">
            <ul class="carousel-list h-full w-full">
                {Math.max(
                    Array.isArray(bannerImages.desktop) ? bannerImages.desktop.length : 0,
                    Array.isArray(bannerImages.mobile) ? bannerImages.mobile.length : 0
                ) && Array.from({ length: Math.max(
                    Array.isArray(bannerImages.desktop) ? bannerImages.desktop.length : 0,
                    Array.isArray(bannerImages.mobile) ? bannerImages.mobile.length : 0
                ) }).map((_, index) => {
                    // 确保至少有一个平台有对应索引的图片
                    const hasDesktopImage = Array.isArray(bannerImages.desktop) && bannerImages.desktop[index];
                    const hasMobileImage = Array.isArray(bannerImages.mobile) && bannerImages.mobile[index];
                    
                    // 如果两个平台都没有对应索引的图片，跳过这个轮播项
                    if (!hasDesktopImage && !hasMobileImage) {
                        return null;
                    }
                    
                    return (
                        <li class={`carousel-item absolute inset-0 transition-all duration-500 ${index === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-110'}`}>
                            <!-- Mobile: use mobile-specific images -->
                            {hasMobileImage && (
                                <ImageWrapper 
                                    alt={`Mobile banner image ${index + 1}`} 
                                    class:list={["block md:hidden object-cover h-full w-full transition-transform duration-500 ease-out"]}
                                    src={Array.isArray(bannerImages.mobile) ? bannerImages.mobile[index] : (typeof bannerImages.mobile === 'string' ? bannerImages.mobile : '')} 
                                    position={siteConfig.appearance.wallpaperMode.defaultBannerPosition}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={index === 0 ? "high" : undefined}
                                />
                            )}
                            <!-- Desktop/Tablet: use desktop-specific images -->
                            {hasDesktopImage && (
                                <ImageWrapper 
                                    alt={`Desktop banner image ${index + 1}`} 
                                    class:list={["hidden md:block object-cover h-full w-full transition-transform duration-500 ease-out"]}
                                    src={Array.isArray(bannerImages.desktop) ? bannerImages.desktop[index] : (typeof bannerImages.desktop === 'string' ? bannerImages.desktop : '')} 
                                    position={siteConfig.appearance.wallpaperMode.defaultBannerPosition}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={index === 0 ? "high" : undefined}
                                />
                            )}
                        </li>
                    );
                }).filter(Boolean)}
            </ul>
        </div>
    ) : (
        <div id="banner-single-container" class="relative h-full w-full" data-desktop-images={JSON.stringify(bannerImages.desktop)} data-mobile-images={JSON.stringify(bannerImages.mobile)} data-position={siteConfig.appearance.wallpaperMode.defaultBannerPosition}>
            <script>
            import "../scripts/banner.js";
            </script>
        </div>
    )}
    
    <!-- Home page text overlay（全屏横幅模式下非首页也渲染，由 JS 控制显隐） -->
    {siteConfig.banner.homeText?.enable && (
        <div id="banner-text-overlay" class={`banner-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="flex flex-col">
                    {homeTextTitle && (
                        <h1 class="banner-title text-6xl lg:text-8xl text-white drop-shadow-lg mb-2 lg:mb-4">
                            {homeTextTitle}
                        </h1>
                    )}
                    {homeTextSubtitle && (
                        <h2 class="banner-subtitle text-xl lg:text-3xl text-white/90 drop-shadow-md">
                            <span class="inline-block min-h-[1.2em]">
                                {siteConfig.banner.homeText.typewriter?.enable ? (
                                    <TypewriterText 
                                        text={homeTextSubtitle}
                                        speed={siteConfig.banner.homeText.typewriter.speed}
                                        deleteSpeed={siteConfig.banner.homeText.typewriter.deleteSpeed}
                                        pauseTime={siteConfig.banner.homeText.typewriter.pauseTime}
                                    />
                                ) : (
                                    Array.isArray(homeTextSubtitle) 
                                        ? homeTextSubtitle[0] 
                                        : homeTextSubtitle
                                )}
                            </span>
                        </h2>
                    )}
                </div>
            </div>
        </div>
    )}
    
    <!-- Water waves effect -->
    {siteConfig.appearance.waves?.enable && (
        <div class="waves absolute -bottom-[1px] h-[10vh] max-h-[9.375rem] min-h-[3.125rem] w-full md:h-[15vh] {siteConfig.appearance.waves?.performanceMode ? 'waves-performance-mode' : ''}" id="header-waves" style="transform: translateZ(0); will-change: fill;">
            <svg
                class="waves"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                viewBox="0 20 150 32"
                preserveAspectRatio="none"
                shape-rendering="auto"
                style="transform: translateZ(0); backface-visibility: hidden;"
            >
                <defs>
                    <path
                        id="gentle-wave"
                        d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
                    >
                    </path>
                </defs>
                <g class="parallax" style="transform: translateZ(0);">
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="0"
                        class="opacity-25 fill-[var(--page-bg)]"
                        style="animation-delay: -2s; animation-duration: 7s; will-change: transform;"
                    ></use>
                    <use
                        xlink:href="#gentle-wave"
                        x="48"
                        y="3"
