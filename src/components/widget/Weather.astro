---
import { Icon } from "astro-icon/components";
import { siteConfig, weatherConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { allTranslations } from "../../utils/i18n-dom-updater";
import { translateToLangMap } from "../../utils/language-utils";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 构建天气相关翻译映射表
const weatherTranslations: Record<string, Record<string, string>> = {};
for (const [lang, tr] of Object.entries(allTranslations)) {
	weatherTranslations[lang] = {
		weather: tr[I18nKey.weather] || "",
		loading: tr[I18nKey.weatherLoading] || "",
		loadFailed: tr[I18nKey.weatherLoadFailed] || "",
		retry: tr[I18nKey.weatherRetry] || "",
		noApiKey: tr[I18nKey.weatherNoApiKey] || "",
		searchPlaceholder: tr[I18nKey.weatherSearchPlaceholder] || "",
		humidity: tr[I18nKey.weatherHumidity] || "",
		wind: tr[I18nKey.weatherWind] || "",
		feelsLike: tr[I18nKey.weatherFeelsLike] || "",
		uv: tr[I18nKey.weatherUV] || "",
		visibility: tr[I18nKey.weatherVisibility] || "",
		forecast: tr[I18nKey.weatherForecast] || "",
		today: tr[I18nKey.weatherToday] || "",
		high: tr[I18nKey.weatherHigh] || "",
		low: tr[I18nKey.weatherLow] || "",
		celsius: tr[I18nKey.weatherCelsius] || "",
		fahrenheit: tr[I18nKey.weatherFahrenheit] || "",
		kmh: tr[I18nKey.weatherKmh] || "",
		mph: tr[I18nKey.weatherMph] || "",
		changeLocation: tr[I18nKey.weatherChangeLocation] || "",
		detectLocation: tr[I18nKey.weatherDetectLocation] || "",
		locationDisabled: tr[I18nKey.weatherLocationDisabled] || "",
		waitingConsent: tr[I18nKey.weatherWaitingConsent] || "",
		defaultLocationHint: tr[I18nKey.weatherDefaultLocationHint] || "",
		defaultLocationConfirm: tr[I18nKey.weatherDefaultLocationConfirm] || "",

		// 天气条件翻译
		condSunny: tr[I18nKey.weatherCondSunny] || "",
		condPartlyCloudy: tr[I18nKey.weatherCondPartlyCloudy] || "",
		condCloudy: tr[I18nKey.weatherCondCloudy] || "",
		condFog: tr[I18nKey.weatherCondFog] || "",
		condDrizzle: tr[I18nKey.weatherCondDrizzle] || "",
		condRain: tr[I18nKey.weatherCondRain] || "",
		condHeavyRain: tr[I18nKey.weatherCondHeavyRain] || "",
		condSnow: tr[I18nKey.weatherCondSnow] || "",
		condHeavySnow: tr[I18nKey.weatherCondHeavySnow] || "",
		condSleet: tr[I18nKey.weatherCondSleet] || "",
		condThunderstorm: tr[I18nKey.weatherCondThunderstorm] || "",
		condHail: tr[I18nKey.weatherCondHail] || "",
		condDust: tr[I18nKey.weatherCondDust] || "",

		// 日历星期翻译（用于预报日期显示）
		calendarSunday: tr[I18nKey.calendarSunday] || "",
		calendarMonday: tr[I18nKey.calendarMonday] || "",
		calendarTuesday: tr[I18nKey.calendarTuesday] || "",
		calendarWednesday: tr[I18nKey.calendarWednesday] || "",
		calendarThursday: tr[I18nKey.calendarThursday] || "",
		calendarFriday: tr[I18nKey.calendarFriday] || "",
		calendarSaturday: tr[I18nKey.calendarSaturday] || "",
	};
}

const weatherTranslationsJSON = JSON.stringify(weatherTranslations);
const translateToI18nMapJSON = JSON.stringify(translateToLangMap);

// WeatherAPI 语言代码映射
const weatherApiLangMap: Record<string, string> = {
	en: "en",
	zh_CN: "zh",
	zh_TW: "zh",
	ja: "ja",
	ko: "ko",
	es: "es",
	th: "th",
	vi: "vi",
	tr: "tr",
	id: "id",
	fr: "fr",
	de: "de",
	ru: "ru",
	ar: "ar",
};
const weatherApiLangMapJSON = JSON.stringify(weatherApiLangMap);
---

<WidgetLayout
	id="weather-widget"
	class={`${className}`}
	style={style}
>
	<!-- 标题行：天气标题 + 位置选择 -->
	<div class="flex justify-between items-center mb-2 mt-4">
		<div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-4 flex items-center
					before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
					before:absolute before:left-[-16px] before:top-[5.5px]"
		>
			<span class="ignore" data-weather-title>{i18n(I18nKey.weather)}</span>
		</div>
	</div>

	<!-- 搜索框（仅加载成功时显示） -->
	<div id="weather-search-box" class="mb-2 hidden">
		<div class="flex gap-1 px-0.5 py-1">
			<input
				id="weather-search-input"
				type="text"
				class="flex-1 px-2 py-1.5 text-sm rounded-lg bg-[var(--card-bg)] border border-[var(--line-divider)] text-neutral-700 dark:text-neutral-300 placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none focus:border-[var(--primary)] transition-colors mr-1"
				placeholder=""
			/>
			<button
				id="weather-search-confirm"
				class="h-8 px-3 text-sm rounded-lg bg-[var(--primary)] text-white hover:opacity-80 transition-opacity shrink-0 flex items-center justify-center"
			>
				<Icon name="material-symbols:search" class="text-base" />
			</button>
		</div>
	</div>

	<!-- 天气内容区域 -->
	<div id="weather-content">
		<!-- 加载状态 -->
		<div id="weather-loading" class="flex flex-col items-center justify-center py-8">
			<div class="weather-spinner mb-3">
				<svg class="weather-spinner-svg" viewBox="0 0 48 48">
					<circle class="weather-spinner-track" cx="24" cy="24" r="20" fill="none" stroke-width="4" />
					<circle class="weather-spinner-arc" cx="24" cy="24" r="20" fill="none" stroke-width="4" stroke-linecap="round" />
				</svg>
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 ignore" data-weather-loading-text>
				{i18n(I18nKey.weatherLoading)}
			</span>
		</div>

		<!-- 加载失败状态 -->
		<div id="weather-error" class="hidden flex flex-col items-center justify-center py-6">
			<div class="text-4xl mb-2 text-[var(--primary)]">
				<Icon name="material-symbols:cloud-off-outline" />
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 mb-3 ignore" data-weather-error-text>
				{i18n(I18nKey.weatherLoadFailed)}
			</span>
			<button
				id="weather-retry-btn"
				class="px-4 py-1.5 text-base rounded-lg bg-[var(--primary)] text-white hover:opacity-80 transition-opacity"
			>
				<span class="ignore" data-weather-retry-text>{i18n(I18nKey.weatherRetry)}</span>
			</button>
		</div>

		<!-- 未配置 API Key 状态 -->
		<div id="weather-noapikey" class="hidden flex flex-col items-center justify-center py-6">
			<div class="text-4xl mb-2 text-[var(--primary)]">
				<Icon name="material-symbols:error-outline" />
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 text-center ignore" data-weather-noapikey-text>
				{i18n(I18nKey.weatherNoApiKey)}
			</span>
		</div>

		<!-- 定位因隐私拒绝被禁用状态 -->
		<div id="weather-location-disabled" class="hidden flex flex-col items-center justify-center py-6">
			<div class="text-4xl mb-2 text-[var(--primary)]">
				<Icon name="material-symbols:location-off-outline" />
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 text-center ignore" data-weather-location-disabled-text>
				{i18n(I18nKey.weatherLocationDisabled)}
			</span>
		</div>

		<!-- 等待 IP 定位授权状态 -->
		<div id="weather-waiting-consent" class="hidden flex flex-col items-center justify-center py-6">
			<div class="weather-spinner mb-3">
				<svg class="weather-spinner-svg" viewBox="0 0 48 48">
					<circle class="weather-spinner-track" cx="24" cy="24" r="20" fill="none" stroke-width="4" />
					<circle class="weather-spinner-arc" cx="24" cy="24" r="20" fill="none" stroke-width="4" stroke-linecap="round" />
				</svg>
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 text-center ignore" data-weather-waiting-consent-text>
				{i18n(I18nKey.weatherWaitingConsent)}
			</span>
		</div>

		<!-- 拒绝隐私后使用默认位置提示 -->
		<div id="weather-default-location-hint" class="hidden flex flex-col items-center justify-center py-6">
			<div class="text-4xl mb-2 text-[var(--primary)]">
				<Icon name="material-symbols:edit-location-alt-outline" />
			</div>
			<span class="text-sm text-neutral-500 dark:text-neutral-400 text-center mb-4 ignore" data-weather-default-location-hint-text>
				{i18n(I18nKey.weatherDefaultLocationHint)}
			</span>
			<button id="weather-default-location-confirm" class="px-4 py-1.5 rounded-lg text-sm font-medium bg-[var(--primary)] text-white hover:opacity-80 transition-opacity">
				{i18n(I18nKey.weatherDefaultLocationConfirm)}
			</button>
		</div>

		<!-- 天气数据（默认隐藏） -->
		<div id="weather-data" class="hidden">
			<!-- 位置信息 -->
			<div id="weather-location" class="flex items-center gap-1 mb-3 px-1">
				<Icon name="material-symbols:location-on-outline" class="text-[var(--primary)] text-xl shrink-0 mr-1" />
				<span id="weather-location-name" class="text-sm text-neutral-600 dark:text-neutral-400 truncate flex-1 min-w-0"></span>
				<div id="weather-action-btns" class="flex items-center gap-1 shrink-0 hidden ml-auto">
					<button
						id="weather-detect-btn"
						class="p-1 rounded-md hover:bg-[var(--btn-plain-bg-hover)] text-[var(--primary)] transition-all"
						aria-label="Detect location"
					>
						<Icon name="material-symbols:my-location" class="text-xl" />
					</button>
				</div>
			</div>

			<!-- 当前天气 -->
			<div class="flex items-center justify-center gap-3 mb-4 px-1">
				<span id="weather-current-icon" class="text-5xl text-[var(--primary)] shrink-0 flex items-center justify-center"></span>
				<div class="min-w-0">
					<div class="flex items-baseline gap-1">
						<span id="weather-current-temp" class="text-3xl font-bold text-neutral-900 dark:text-neutral-100"></span>
						<span id="weather-temp-unit" class="text-lg text-neutral-500 dark:text-neutral-400"></span>
					</div>
					<span id="weather-current-condition" class="text-sm text-neutral-600 dark:text-neutral-400 ignore"></span>
				</div>
			</div>

			<!-- 天气详情 -->
			<div class="grid grid-cols-2 gap-2 mb-4 px-1">
				<div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.33_0.035_var(--hue))]">
					<Icon name="material-symbols:humidity-percentage-outline" class="text-[var(--primary)] text-xl shrink-0" />
					<div class="min-w-0">
						<div class="text-sm text-neutral-500 dark:text-neutral-400 ignore" data-weather-detail-humidity>{i18n(I18nKey.weatherHumidity)}</div>
						<span id="weather-humidity" class="ignore text-sm font-medium text-neutral-900 dark:text-neutral-100"></span>
					</div>
				</div>
				<div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.33_0.035_var(--hue))]">
					<Icon name="material-symbols:air" class="text-[var(--primary)] text-xl shrink-0" />
					<div class="min-w-0">
						<div class="text-sm text-neutral-500 dark:text-neutral-400 ignore" data-weather-detail-wind>{i18n(I18nKey.weatherWind)}</div>
						<span id="weather-wind" class="ignore text-sm font-medium text-neutral-900 dark:text-neutral-100"></span>
					</div>
				</div>
				<div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.33_0.035_var(--hue))]">
					<Icon name="material-symbols:thermometer" class="text-[var(--primary)] text-xl shrink-0" />
					<div class="min-w-0">
						<div class="text-sm text-neutral-500 dark:text-neutral-400 ignore" data-weather-detail-feelslike>{i18n(I18nKey.weatherFeelsLike)}</div>
						<span id="weather-feelslike" class="ignore text-sm font-medium text-neutral-900 dark:text-neutral-100"></span>
					</div>
				</div>
				<div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.33_0.035_var(--hue))]">
					<Icon name="material-symbols:wb-sunny-outline" class="text-[var(--primary)] text-xl shrink-0" />
					<div class="min-w-0">
						<div class="text-sm text-neutral-500 dark:text-neutral-400 ignore" data-weather-detail-uv>{i18n(I18nKey.weatherUV)}</div>
						<span id="weather-uv" class="ignore text-sm font-medium text-neutral-900 dark:text-neutral-100"></span>
					</div>
				</div>
			</div>

			<!-- 7天预报 -->
			<div class="flex items-center gap-1 mb-2 px-1">
				<Icon name="material-symbols:calendar-month-outline" class="text-[var(--primary)] text-xl mr-1" />
				<span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 ignore" data-weather-forecast-title>{i18n(I18nKey.weatherForecast)}</span>
			</div>
			<div id="weather-forecast" class="flex flex-col gap-1.5 pr-1">
			</div>
		</div>
	</div>
</WidgetLayout>

<script
	is:inline
	define:vars={{
		apiKey: weatherConfig.apiKey,
		defaultLocation: weatherConfig.defaultLocation,
		unit: weatherConfig.unit || "celsius",
		weatherTranslationsJSON,
		translateToI18nMapJSON,
		weatherApiLangMapJSON,
		defaultLang: siteConfig.lang,
	}}
>
	// 解析翻译映射表
	const weatherTranslations = JSON.parse(weatherTranslationsJSON);
	const translateToLangMap = JSON.parse(translateToI18nMapJSON);
	const weatherApiLangMap = JSON.parse(weatherApiLangMapJSON);

	const WEATHER_CACHE_KEY = "brightmoon_weather_cache";
	const WEATHER_LOCATION_KEY = "brightmoon_weather_location";
	const WEATHER_TIMEOUT = 10000; // 10秒超时

	// 缓存当前天气数据，用于语言切换时重新渲染
	var lastWeatherData = null;
	var _pendingDefaultLocationHint = false;
	var _showDefaultLocationHint = false;
	var _weatherConsentAC = null; // AbortController for cleaning up consent listener

	// 获取当前 i18n 语言
	function getLang() {
		const translateTo = window.translationManager?.getTargetLanguage() || window.translate?.to;
		if (translateTo) {
			return translateToLangMap[translateTo] || defaultLang;
		}
		return defaultLang;
	}

	// 获取当前语言的翻译
	function getTr(key) {
		const lang = getLang();
		return weatherTranslations[lang]?.[key] || weatherTranslations.en?.[key] || key;
	}

	// 获取 WeatherAPI 语言代码
	function getWeatherApiLang() {
		const lang = getLang();
		return weatherApiLangMap[lang] || "en";
	}

	// WeatherAPI 条件代码 → i18n 键映射（基于 weatherapi.com 官方 60 个条件码）
	var conditionCodeMap = {
		1000: "condSunny",
		1003: "condPartlyCloudy",
		1006: "condCloudy",
		1009: "condCloudy",
		1012: "condDust",
		1015: "condDust",
		1018: "condDust",
		1021: "condDust",
		1024: "condDust",
		1027: "condDust",
		1030: "condFog",
		1033: "condDust",
		1036: "condDust",
		1039: "condDust",
		1042: "condDust",
		1045: "condDust",
		1048: "condDust",
		1063: "condRain",
		1066: "condSnow",
		1069: "condSleet",
		1072: "condDrizzle",
		1087: "condThunderstorm",
		1114: "condSnow",
		1117: "condHeavySnow",
		1135: "condFog",
		1147: "condFog",
		1150: "condDrizzle",
		1153: "condDrizzle",
		1168: "condDrizzle",
		1171: "condDrizzle",
		1180: "condRain",
		1183: "condRain",
		1186: "condRain",
		1189: "condRain",
		1192: "condHeavyRain",
		1195: "condHeavyRain",
		1198: "condHeavyRain",
		1201: "condHeavyRain",
		1204: "condSleet",
		1207: "condSleet",
		1210: "condSnow",
		1213: "condSnow",
		1216: "condSnow",
		1219: "condSnow",
		1222: "condHeavySnow",
		1225: "condHeavySnow",
		1237: "condHail",
		1240: "condRain",
		1243: "condRain",
		1246: "condHeavyRain",
		1249: "condSleet",
		1252: "condSleet",
		1255: "condSnow",
		1258: "condHeavySnow",
		1261: "condHail",
		1264: "condHail",
		1273: "condThunderstorm",
		1276: "condThunderstorm",
		1279: "condThunderstorm",
		1282: "condThunderstorm",
	};

	// 根据条件代码获取翻译后的天气描述
	function getConditionText(code, fallbackText) {
		var i18nKey = conditionCodeMap[code];
		if (i18nKey) {
			var translated = getTr(i18nKey);
			if (translated && translated !== i18nKey) return translated;
		}
		return fallbackText || "";
	}

	// DOM 元素缓存
	const dom = {
		loading: document.getElementById("weather-loading"),
		error: document.getElementById("weather-error"),
		noapikey: document.getElementById("weather-noapikey"),
		locationDisabled: document.getElementById("weather-location-disabled"),
		waitingConsent: document.getElementById("weather-waiting-consent"),
		defaultLocationLoading: document.getElementById("weather-default-location-hint"),
		defaultLocationConfirmBtn: document.getElementById("weather-default-location-confirm"),
		data: document.getElementById("weather-data"),
		locationName: document.getElementById("weather-location-name"),
		currentIcon: document.getElementById("weather-current-icon"),
		currentTemp: document.getElementById("weather-current-temp"),
		tempUnit: document.getElementById("weather-temp-unit"),
		currentCondition: document.getElementById("weather-current-condition"),
		humidity: document.getElementById("weather-humidity"),
		wind: document.getElementById("weather-wind"),
		feelslike: document.getElementById("weather-feelslike"),
		uv: document.getElementById("weather-uv"),
		forecast: document.getElementById("weather-forecast"),
		actionBtns: document.getElementById("weather-action-btns"),
		searchBox: document.getElementById("weather-search-box"),
		searchInput: document.getElementById("weather-search-input"),

		searchConfirm: document.getElementById("weather-search-confirm"),
		detectBtn: document.getElementById("weather-detect-btn"),
		retryBtn: document.getElementById("weather-retry-btn"),
		loadingText: document.querySelector("[data-weather-loading-text]"),
		errorText: document.querySelector("[data-weather-error-text]"),
		retryText: document.querySelector("[data-weather-retry-text]"),
		noApiKeyText: document.querySelector("[data-weather-noapikey-text]"),
		locationDisabledText: document.querySelector("[data-weather-location-disabled-text]"),
		waitingConsentText: document.querySelector("[data-weather-waiting-consent-text]"),
		defaultLocationHintText: document.querySelector("[data-weather-default-location-hint-text]"),
		titleEl: document.querySelector("[data-weather-title]"),
		searchPlaceholder: document.getElementById("weather-search-input"),
		forecastTitle: document.querySelector("[data-weather-forecast-title]"),
		detailHumidity: document.querySelector("[data-weather-detail-humidity]"),
		detailWind: document.querySelector("[data-weather-detail-wind]"),
		detailFeelslike: document.querySelector("[data-weather-detail-feelslike]"),
		detailUv: document.querySelector("[data-weather-detail-uv]"),
	};

	// 显示不同状态
	function showState(state) {
		dom.loading.classList.toggle("hidden", state !== "loading");
		dom.error.classList.toggle("hidden", state !== "error");
		dom.noapikey.classList.toggle("hidden", state !== "noapikey");
		dom.locationDisabled.classList.toggle("hidden", state !== "locationDisabled");
		dom.waitingConsent.classList.toggle("hidden", state !== "waitingConsent");
		dom.defaultLocationLoading.classList.toggle("hidden", state !== "defaultLocationHint");
		dom.data.classList.toggle("hidden", state !== "data");
		// 仅加载成功时显示搜索框
		var isDataState = state === "data";
		dom.searchBox.classList.toggle("hidden", !isDataState);
		// 定位按钮：加载成功且 IP 定位未被拒绝时才显示
		var ipAllowed = isIpLocationAllowed();
		dom.actionBtns.classList.toggle("hidden", !(isDataState && ipAllowed));
	}

	// WeatherAPI 条件代码 → Material Symbols 图标映射
	var weatherIconMap = {
		1000: { day: "wb-sunny-outline", night: "nightlight-outline" },
		1003: { day: "partly-cloudy-day-outline", night: "partly-cloudy-night-outline" },
		1006: { day: "cloud-outline", night: "cloud-outline" },
		1009: { day: "cloud-outline", night: "cloud-outline" },
		1030: { day: "cloud-outline", night: "cloud-outline" },
		1063: { day: "rainy-outline", night: "rainy-outline" },
		1066: { day: "snowing", night: "snowing" },
		1069: { day: "rainy-snow", night: "rainy-snow" },
		1072: { day: "rainy-outline", night: "rainy-outline" },
		1075: { day: "rainy-heavy", night: "rainy-heavy" },
		1077: { day: "snowing-heavy", night: "snowing-heavy" },
		1080: { day: "cloudy-snowing-outline", night: "cloudy-snowing-outline" },
		1087: { day: "thunderstorm-outline", night: "thunderstorm-outline" },
		1114: { day: "snowing", night: "snowing" },
		1117: { day: "snowing-heavy", night: "snowing-heavy" },
		1135: { day: "cloud-outline", night: "cloud-outline" },
		1147: { day: "cloud-outline", night: "cloud-outline" },
		1150: { day: "rainy-outline", night: "rainy-outline" },
		1153: { day: "rainy-outline", night: "rainy-outline" },
		1168: { day: "rainy-outline", night: "rainy-outline" },
		1171: { day: "rainy-outline", night: "rainy-outline" },
