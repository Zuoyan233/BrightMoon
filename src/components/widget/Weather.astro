	};

	function getWeatherIcon(code, isDay) {
		var mapping = weatherIconMap[code];
		if (mapping) {
			return isDay ? mapping.day : mapping.night;
		}
		return isDay ? "wb-sunny-outline" : "nightlight-outline";
	}

	function renderWeatherIcon(element, code, isDay, size) {
		var iconName = getWeatherIcon(code, isDay);
		element.innerHTML = '<iconify-icon icon="material-symbols:' + iconName + '" width="' + (size || 48) + '" height="' + (size || 48) + '"></iconify-icon>';
	}

	// 获取星期几名称
	function getDayName(dateStr) {
		const date = new Date(dateStr + "T12:00:00");
		const dayKeys = [
			"calendarSunday",
			"calendarMonday",
			"calendarTuesday",
			"calendarWednesday",
			"calendarThursday",
			"calendarFriday",
			"calendarSaturday",
		];
		const fallbackDays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
		const dayIndex = date.getDay();
		return getTr(dayKeys[dayIndex]) || fallbackDays[dayIndex];
	}

	// 判断是否是今天
	function isToday(dateStr) {
		const today = new Date();
		const date = new Date(dateStr + "T12:00:00");
		return today.getFullYear() === date.getFullYear() &&
			today.getMonth() === date.getMonth() &&
			today.getDate() === date.getDate();
	}

	// 渲染天气数据
	function renderWeather(data) {
		lastWeatherData = data;

		// 如果是拒绝隐私后使用默认位置加载完成，先显示提示
		if (_pendingDefaultLocationHint) {
			_pendingDefaultLocationHint = false;
			_showDefaultLocationHint = true;
			showState("defaultLocationHint");
			updateUILanguage();
			return;
		}

		_showDefaultLocationHint = false;
		const isCelsius = unit === "celsius";

		// 位置信息
		dom.locationName.textContent = `${data.location.name}, ${data.location.country}`;

		// 当前天气
		var isDay = data.current.is_day === 1;
		renderWeatherIcon(dom.currentIcon, data.current.condition.code, isDay, 48);
		dom.currentIcon.setAttribute("aria-label", data.current.condition.text);

		if (isCelsius) {
			dom.currentTemp.textContent = Math.round(data.current.temp_c);
			dom.tempUnit.textContent = "°C";
		} else {
			dom.currentTemp.textContent = Math.round(data.current.temp_f);
			dom.tempUnit.textContent = "°F";
		}

		dom.currentCondition.textContent = getConditionText(data.current.condition.code, data.current.condition.text);

		// 天气详情
		dom.humidity.textContent = `${data.current.humidity}%`;
		if (isCelsius) {
			dom.wind.textContent = `${data.current.wind_kph} ${getTr("kmh") || "km/h"}`;
			dom.feelslike.textContent = `${Math.round(data.current.feelslike_c)}°C`;
		} else {
			dom.wind.textContent = `${data.current.wind_mph} ${getTr("mph") || "mph"}`;
			dom.feelslike.textContent = `${Math.round(data.current.feelslike_f)}°F`;
		}
		dom.uv.textContent = data.current.uv;

		// 7天预报
		if (data.forecast && data.forecast.forecastday) {
			let forecastHtml = "";
			data.forecast.forecastday.forEach(function(day) {
				var forecastIconName = getWeatherIcon(day.day.condition.code, true);
				const dayLabel = isToday(day.date) ? (getTr("today") || "Today") : getDayName(day.date);
				const maxTemp = isCelsius ? Math.round(day.day.maxtemp_c) : Math.round(day.day.maxtemp_f);
				const minTemp = isCelsius ? Math.round(day.day.mintemp_c) : Math.round(day.day.mintemp_f);
				const tempSymbol = isCelsius ? "°" : "°";

				const condText = getConditionText(day.day.condition.code, day.day.condition.text);

				forecastHtml += '<div class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--btn-plain-bg-hover)] transition-colors">' +
					'<span class="text-sm text-neutral-500 dark:text-neutral-400 w-8 shrink-0 ignore">' + dayLabel + '</span>' +
					'<iconify-icon icon="material-symbols:' + forecastIconName + '" width="22" height="22" class="shrink-0 ml-2 text-xl text-[var(--primary)]"></iconify-icon>' +
					'<span class="text-sm text-neutral-600 dark:text-neutral-400 truncate ignore">' + condText + '</span>' +
					'<div class="flex items-center gap-1 shrink-0 ml-auto">' +
						'<span class="text-sm font-bold text-neutral-900 dark:text-neutral-100">' + maxTemp + tempSymbol + '</span>' +
						'<span class="text-sm text-neutral-400">/</span>' +
						'<span class="text-sm text-neutral-500 dark:text-neutral-400">' + minTemp + tempSymbol + '</span>' +
					'</div>' +
				'</div>';
			});
			dom.forecast.innerHTML = forecastHtml;
		}

		showState("data");
	}

	// 更新界面语言
	function updateUILanguage() {
		if (dom.loadingText) dom.loadingText.textContent = getTr("loading");
		if (dom.errorText) dom.errorText.textContent = getTr("loadFailed");
		if (dom.retryText) dom.retryText.textContent = getTr("retry");
		if (dom.noApiKeyText) dom.noApiKeyText.textContent = getTr("noApiKey");
		if (dom.locationDisabledText) dom.locationDisabledText.textContent = getTr("locationDisabled") || "Location disabled due to privacy rejection";
		if (dom.waitingConsentText) dom.waitingConsentText.textContent = getTr("waitingConsent") || "Waiting for location authorization...";
		if (dom.defaultLocationHintText) dom.defaultLocationHintText.textContent = getTr("defaultLocationHint") || "Using default location due to privacy rejection";
		if (dom.defaultLocationConfirmBtn) dom.defaultLocationConfirmBtn.textContent = getTr("defaultLocationConfirm") || "OK";
		if (dom.titleEl) {
			dom.titleEl.textContent = getTr("weather") || "Weather";
			dom.titleEl.classList.add("ignore");
			dom.titleEl.setAttribute("data-i18n-handled", "true");
		}
		if (dom.searchPlaceholder) dom.searchPlaceholder.placeholder = getTr("searchPlaceholder") || "Search city...";
		if (dom.forecastTitle) {
			dom.forecastTitle.textContent = getTr("forecast") || "7-Day Forecast";
			dom.forecastTitle.classList.add("ignore");
			dom.forecastTitle.setAttribute("data-i18n-handled", "true");
		}
		if (dom.detailHumidity) {
			dom.detailHumidity.textContent = getTr("humidity") || "Humidity";
			dom.detailHumidity.classList.add("ignore");
			dom.detailHumidity.setAttribute("data-i18n-handled", "true");
		}
		if (dom.detailWind) {
			dom.detailWind.textContent = getTr("wind") || "Wind";
			dom.detailWind.classList.add("ignore");
			dom.detailWind.setAttribute("data-i18n-handled", "true");
		}
		if (dom.detailFeelslike) {
			dom.detailFeelslike.textContent = getTr("feelsLike") || "Feels Like";
			dom.detailFeelslike.classList.add("ignore");
			dom.detailFeelslike.setAttribute("data-i18n-handled", "true");
		}
		if (dom.detailUv) {
			dom.detailUv.textContent = getTr("uv") || "UV";
			dom.detailUv.classList.add("ignore");
			dom.detailUv.setAttribute("data-i18n-handled", "true");
		}
	}

	// 获取天气数据
	async function fetchWeather(query) {
		if (!apiKey) {
			console.warn("WeatherAPI key is not configured");
			showState("noapikey");
			updateUILanguage();
			return;
		}

		showState("loading");
		updateUILanguage();

		const lang = getWeatherApiLang();
		const url = "https://api.weatherapi.com/v1/forecast.json?key=" + apiKey + "&q=" + encodeURIComponent(query) + "&days=7&lang=" + lang + "&aqi=no&alerts=no";

		const controller = new AbortController();
		const timeoutId = setTimeout(function() { controller.abort(); }, WEATHER_TIMEOUT);

		try {
			const response = await fetch(url, { signal: controller.signal });
			clearTimeout(timeoutId);

			if (!response.ok) {
				throw new Error("API request failed: " + response.status);
			}

			const data = await response.json();

			// 缓存数据
			try {
				localStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify({
					data: data,
					timestamp: Date.now(),
					query: query,
					lang: getWeatherApiLang(),
				}));
			} catch (e) {
				// localStorage 不可用时忽略
			}

			// 保存使用的位置
			try {
				localStorage.setItem(WEATHER_LOCATION_KEY, query);
			} catch (e) {}

			renderWeather(data);
		} catch (error) {
			clearTimeout(timeoutId);
			if (error.name === "AbortError") {
				console.warn("Weather API request timed out");
			} else {
				console.error("Failed to fetch weather:", error);
			}
			showState("error");
			updateUILanguage();
		}
	}

	// 获取初始查询位置
	function getInitialQuery() {
		// 检查隐私同意状态
		try {
			var consent = localStorage.getItem('siteNoticeConsent');
			if (consent === 'rejected') {
				return defaultLocation || null; // 拒绝时不用 auto:ip
			}
		} catch (e) {}

		try {
			const savedLocation = localStorage.getItem(WEATHER_LOCATION_KEY);
			if (savedLocation && savedLocation !== 'auto:ip') return savedLocation;
		} catch (e) {}
		return defaultLocation || "auto:ip";
	}

	// 检查是否允许 IP 定位
	function isIpLocationAllowed() {
		try {
			var consent = localStorage.getItem('siteNoticeConsent');
			return consent !== 'rejected';
		} catch (e) {
			return true;
		}
	}

	// 检查用户是否已做出隐私选择
	function hasConsentChoice() {
		try {
			var consent = localStorage.getItem('siteNoticeConsent');
			return consent === 'accepted' || consent === 'rejected';
		} catch (e) {
			return true;
		}
	}

	// 加载缓存或请求新数据
	async function loadWeather(query) {
		if (!query) query = getInitialQuery();

		// 尝试使用缓存（10分钟内有效）
		try {
			const cached = localStorage.getItem(WEATHER_CACHE_KEY);
			if (cached) {
				const parsed = JSON.parse(cached);
				const age = Date.now() - parsed.timestamp;
				if (age < 600000 && parsed.query === query) {
					renderWeather(parsed.data);
					return;
				}
			}
		} catch (e) {}

		await fetchWeather(query);
	}

	// 事件监听
	// 搜索确认

	dom.searchConfirm.addEventListener("click", function() {
		const query = dom.searchInput.value.trim();
		if (query) {
			dom.searchInput.value = "";
			loadWeather(query);
		}
	});

	dom.searchInput.addEventListener("keydown", function(e) {
		if (e.key === "Enter") {
			dom.searchConfirm.click();
		}
	});

	dom.detectBtn.addEventListener("click", function() {
		if (!isIpLocationAllowed()) {
			showState("locationDisabled");
			updateUILanguage();
			return;
		}
		loadWeather("auto:ip");
	});

	dom.retryBtn.addEventListener("click", function() {
		loadWeather(getInitialQuery());
	});

	dom.defaultLocationConfirmBtn.addEventListener("click", function() {
		if (lastWeatherData) {
			renderWeather(lastWeatherData);
		} else {
			loadWeather(defaultLocation);
		}
	});

	// 注册翻译刷新回调
	function registerWeatherRenderer() {
		if (!window.translationManager) return;
		window.translationManager.onRefresh("weather", function() {
			updateUILanguage();
			// 语言切换时，如果正在显示默认位置提示，保持提示界面
			if (_showDefaultLocationHint) {
				showState("defaultLocationHint");
				return;
			}
			// 语言切换时，使用缓存的天气数据重新渲染（条件文本通过i18n翻译）
			if (lastWeatherData) {
				renderWeather(lastWeatherData);
			}
		});
	}

	registerWeatherRenderer();
	document.addEventListener("translation-manager:ready", registerWeatherRenderer, { once: true });

	// 清理旧的 consent 监听器，避免 Swup 导航累积
	if (_weatherConsentAC) _weatherConsentAC.abort();
	_weatherConsentAC = new AbortController();

	// 监听 cookie 同意状态变化
	window.addEventListener("siteNoticeConsentChange", function(e) {
		if (e.detail === 'rejected') {
			// 清除天气缓存和位置缓存
			try {
				localStorage.removeItem(WEATHER_CACHE_KEY);
				localStorage.removeItem(WEATHER_LOCATION_KEY);
			} catch (err) {}
			lastWeatherData = null;
			// 如果没有默认位置，显示禁用状态
			if (!defaultLocation) {
				showState("locationDisabled");
				updateUILanguage();
			} else {
				// 先加载天气，加载完成后显示提示
				showState("loading");
				updateUILanguage();
				_pendingDefaultLocationHint = true;
				loadWeather(defaultLocation);
			}
		} else if (e.detail === 'accepted') {
			// 同意后重新加载天气
			loadWeather();
		}
	}, { signal: _weatherConsentAC.signal });

	// 初始化
	updateUILanguage();
	// 如果用户尚未做出隐私选择，显示等待授权提示
	if (!hasConsentChoice()) {
		showState("waitingConsent");
	} else if (!getInitialQuery() && !isIpLocationAllowed()) {
		// 没有默认位置且 IP 定位被拒绝，显示禁用状态
		showState("locationDisabled");
	} else if (!getInitialQuery()) {
		showState("error");
		updateUILanguage();
	} else {
		loadWeather();
	}
</script>

