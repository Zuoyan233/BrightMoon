---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import { getFileDirFromPath, getPostUrl, getTagUrl } from "@/utils/url-utils";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	style?: string;
}

const { entry, style } = Astro.props;
const className = Astro.props.class;

// 解构文章元数据
const {
	title,
	published,
	updated,
	tags,
	category,
	image,
	description,
	pinned,
	encrypted,
	password,
} = entry.data;

// 文章是否加密：需要同时设置 encrypted 标志和 password
const isEncrypted = encrypted && password;

// 生成文章 URL、判断是否有封面图
const url = getPostUrl(entry);
const hasCover = image !== undefined && image !== null && image !== "";
// 封面宽度占比（桌面端）
const coverWidth = "28%";

// 渲染文章以获取 remark 插件提取的 frontmatter（字数、摘要等）
const { remarkPluginFrontmatter } = await render(entry);

// 卡片上默认显示的标签数量，超出部分折叠
const TAG_VISIBLE_LIMIT = 5;
---

<!-- 文章卡片：包含标题、元数据、摘要、标签，以及可选的封面图或进入按钮 -->
<div
	class:list={[
		"card-base flex flex-col-reverse md:flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative",
		className,
	]}
	style={style}
>
	<!-- 文字内容区域：根据是否有封面图动态调整宽度 -->
	<div
		class:list={[
			"pl-6 md:pl-9 pr-6 md:pr-2 pt-6 md:pt-7 pb-6 relative",
			{
				"w-full md:w-[calc(100%_-_3.25rem_-_0.75rem)]": !hasCover,
				"w-full md:w-[calc(100%_-_var(--coverWidth)_-_0.75rem)]":
					hasCover,
			},
		]}
	>
		<!-- 文章标题链接：含置顶图标、加密图标、hover 箭头 -->
		<a
			href={url}
			class="transition group w-full block font-bold mb-3 text-3xl text-90
        hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
        active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
        before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
        before:absolute
        before:top-[2.35rem] before:left-[1.125rem] before:hidden md:before:block"
		>
			<!-- 置顶图标 -->
			{
				pinned && (
					<Icon
						name="material-symbols:push-pin"
						is:inline
						class="inline text-[var(--primary)] text-2xl mr-2 -translate-y-0.5"
					/>
				)
			}
			<!-- 加密图标 -->
			{
				isEncrypted && (
					<Icon
						name="material-symbols:lock-outline"
						is:inline
						class="inline text-[var(--primary)] text-2xl mr-2 -translate-y-0.5"
					/>
				)
			}
			{title}
			<!-- 移动端：始终显示的右箭头 -->
			<Icon
				is:inline
				class="inline text-[2rem] text-[var(--btn-content)] md:hidden translate-y-0.5 absolute"
				name="material-symbols:chevron-right-rounded"
			/>
			<!-- 桌面端：hover 时淡入的右箭头 -->
			<Icon
				is:inline
				class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
				name="material-symbols:chevron-right-rounded"
			/>
		</a>

		<!-- 文章元数据：发布日期、分类、字数等 -->
		<PostMetadata
			published={published}
			updated={updated}
			tags={tags}
			category={category || ""}
			hideTagsForMobile={true}
			hideUpdateDate={true}
			className="mb-4"
			showOnlyBasicMeta={true}
			words={remarkPluginFrontmatter.words}
			showWordCount={true}
		/>

		<!-- 文章摘要：优先使用 description，否则使用自动提取的 excerpt -->
		<div
			class:list={[
				"transition text-75 mb-3.5 pr-4",
				{ "line-clamp-2 md:line-clamp-1": !description },
			]}
		>
			{description || remarkPluginFrontmatter.excerpt}
		</div>

		<!-- 标签列表：前 4 个常显，超出部分折叠，点击 “…” 展开 -->
		<div
			class="post-tags flex flex-wrap items-center gap-2 mt-2"
			data-tag-collapsed="true"
		>
			{
				tags && tags.length > 0 ? (
					tags.map((tag: string, index: number) => (
						<a
							href={getTagUrl(tag)}
							class:list={[
								"tag-item",
								{ hidden: index >= TAG_VISIBLE_LIMIT },
								siteConfig.tagStyle?.useNewStyle
									? "link-lg transition text-60 text-xs font-medium px-2 py-1 rounded-lg hover:text-[var(--primary)] dark:hover:text-[var(--primary)] active:text-[var(--primary)] dark:active:text-[var(--primary)] group/tag whitespace-nowrap"
									: "btn-regular h-6 text-xs px-2 rounded-lg",
							]}
							aria-label={`View all posts tagged with ${tag.trim()}`}
						>
							<span class="transition-transform group-hover/tag:translate-x-0.5">
								# {tag.trim()}
							</span>
						</a>
					))
				) : (
					<span class="text-xs text-60">{i18n(I18nKey.noTags)}</span>
				)
			}
			{
				tags && tags.length > TAG_VISIBLE_LIMIT ? (
					<button
						type="button"
						class="tag-toggle btn-regular text-[var(--btn-content)] h-6 text-xs px-2 rounded-md"
						aria-label={i18n(I18nKey.showAllTags)}
						title={i18n(I18nKey.showAllTags)}
						aria-expanded="false"
						data-visible-limit={TAG_VISIBLE_LIMIT}
						data-label-show={i18n(I18nKey.showAllTags)}
						data-label-hide={i18n(I18nKey.hideAllTags)}
					>
						<Icon
							is:inline
							name="material-symbols:expand-more"
							class="tag-toggle-icon text-base transition-transform"
						/>
					</button>
				) : null
			}
		</div>
	</div>

	<!-- 封面图区域：桌面端绝对定位在右侧，hover 时显示遮罩和箭头 -->
	{
		hasCover && (
			<a
				href={url}
				aria-label={title}
				class:list={[
					"group",
					"max-h-[20vh] md:max-h-none mx-4 mt-4 -mb-2 md:mb-0 md:mx-0 md:mt-0",
					"md:w-[var(--coverWidth)] relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95",
				]}
			>
				<div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition" />
				<div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
					<Icon
						name="material-symbols:chevron-right-rounded"
						is:inline
						class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl"
					/>
				</div>
				<ImageWrapper
					src={image}
					basePath={getFileDirFromPath(entry.filePath || "")}
					alt="Cover Image of the Post"
					class="w-full h-full"
				/>
			</a>
		)
	}

	<!-- 无封面图时：桌面端显示一个进入按钮替代封面 -->
	{
		!hasCover && (
			<a
				href={url}
				aria-label={title}
				class="!hidden md:!flex btn-regular w-[3.25rem]
         absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
         hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95
        "
			>
				<Icon
					name="material-symbols:chevron-right-rounded"
					is:inline
					class="transition text-[var(--btn-content)] text-4xl mx-auto"
				/>
			</a>
		)
	}
</div>
<!-- 移动端卡片分隔线 -->
<div
	class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"
>
</div>

<style define:vars={{ coverWidth }}></style>

<script>
	const setupTagToggles = () => {
		const containers = document.querySelectorAll<HTMLElement>(
			".post-tags[data-tag-bound]",
		);

		for (const container of containers) {
			container.removeAttribute("data-tag-bound");
		}

		for (const container of document.querySelectorAll<HTMLElement>(
			".post-tags",
		)) {
			container.setAttribute("data-tag-bound", "");

			const toggle = container.querySelector<HTMLElement>(".tag-toggle");
			if (!toggle) continue;

			const limit = Number(toggle.dataset.visibleLimit ?? 4);

			toggle.addEventListener("click", (event) => {
				event.preventDefault();
				event.stopPropagation();

				const isCollapsed =
					container.getAttribute("data-tag-collapsed") === "true";
				const items =
					container.querySelectorAll<HTMLElement>(".tag-item");

				for (const [index, item] of items.entries()) {
					if (index >= limit) {
						item.classList.toggle("hidden", !isCollapsed);
					}
				}

				container.setAttribute(
					"data-tag-collapsed",
					isCollapsed ? "false" : "true",
				);
				toggle.setAttribute(
					"aria-expanded",
					isCollapsed ? "true" : "false",
				);

				const icon =
					toggle.querySelector<HTMLElement>(".tag-toggle-icon");

				if (icon) {
					icon.classList.toggle("rotate-180", isCollapsed);
				}

				const label = isCollapsed
					? toggle.dataset.labelHide
					: toggle.dataset.labelShow;

				if (label) {
					toggle.setAttribute("aria-label", label);
					toggle.setAttribute("title", label);
				}
			});
		}
	};

	document.addEventListener("DOMContentLoaded", setupTagToggles);
	document.addEventListener("swup:page:view", setupTagToggles);
	document.addEventListener("brightmoon:page:loaded", setupTagToggles);
</script>
