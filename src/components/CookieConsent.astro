---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

interface Props {
	enable: boolean;
}

const { enable } = Astro.props;

const title = i18n(I18nKey.cookieConsentTitle);
const description = i18n(I18nKey.cookieConsentDescription);
const ipInfoLoading = i18n(I18nKey.cookieConsentIpInfo);
const ipInfoTimeout = i18n(I18nKey.cookieConsentIpTimeout);
const acceptText = i18n(I18nKey.cookieConsentAccept);
const rejectText = i18n(I18nKey.cookieConsentReject);
const learnMoreText = i18n(I18nKey.cookieConsentLearnMore);
const privacyTitle = i18n(I18nKey.cookieConsentPrivacyTitle);
const privacyIntro = i18n(I18nKey.cookieConsentPrivacyIntro);
const privacyEssential = i18n(I18nKey.cookieConsentPrivacyEssential);
const privacyAnalytics = i18n(I18nKey.cookieConsentPrivacyAnalytics);
const privacyAdvertising = i18n(I18nKey.cookieConsentPrivacyAdvertising);
const privacyThirdParty = i18n(I18nKey.cookieConsentPrivacyThirdParty);
const privacyRejectNotice = i18n(I18nKey.cookieConsentPrivacyRejectNotice);
const privacyClose = i18n(I18nKey.cookieConsentPrivacyClose);

const uid = Math.random().toString(36).slice(2, 10);
const dialogUid = Math.random().toString(36).slice(2, 10);
---

<div
    data-overlay={uid}
    class="fixed inset-0 z-[9998] bg-black/25 dark:bg-black/45"
    style="opacity:0;pointer-events:none;transition:opacity 0.4s cubic-bezier(0.4,0,0.2,1)"
>
</div>
<div
    data-bid={uid}
    class="fixed bottom-0 left-0 right-0 z-[9999] bg-[var(--card-bg-transparent)] shadow-[0_-4px_24px_rgba(0,0,0,0.08)] dark:shadow-[0_-4px_24px_rgba(0,0,0,0.3)]"
    style="transform:translateY(100%);opacity:0;pointer-events:none;transition:transform 0.4s cubic-bezier(0.4,0,0.2,1),opacity 0.4s cubic-bezier(0.4,0,0.2,1)"
>
    <div
        class="max-w-[75rem] mx-auto px-6 py-4 flex items-center gap-6 max-md:flex-col max-md:gap-4 max-md:p-4"
    >
        <div class="flex-1 min-w-0">
            <div
                class="flex items-center gap-2 text-xl font-bold text-[var(--primary)] mb-2"
            >
                <Icon
                    name="material-symbols:cookie-outline"
                    class="shrink-0 w-5 h-5"
                />
                <span>{title}</span>
            </div>
            <div class="text-sm leading-relaxed text-90">
                <p class="mb-1.5">
                    {description}
                    <button
                        data-learn-more={uid}
                        class="text-xs text-[var(--primary)] underline cursor-pointer bg-transparent border-none"
                    >
                        {learnMoreText}
                    </button>
                </p>
                <p class="ignore text-xs text-75 opacity-[0.85]">
                    {ipInfoLoading}
                </p>
            </div>
        </div>
        <div
            class="flex flex-col gap-2 shrink-0 min-w-[120px] max-md:flex-row max-md:flex-wrap max-md:w-full"
        >
            <button
                data-consent-btn="accept"
                class="btn-regular px-4 py-2 rounded-md cursor-pointer border-none whitespace-nowrap max-md:flex-1 max-md:min-w-[100px]"
            >
                {acceptText}
            </button>
            <button
                data-consent-btn="reject"
                class="btn-regular px-4 py-2 rounded-md cursor-pointer border-none whitespace-nowrap max-md:flex-1 max-md:min-w-[100px]"
            >
                {rejectText}
            </button>
        </div>
    </div>
</div>

<!-- 隐私协议详情弹窗 -->
<dialog
    data-privacy-dialog={dialogUid}
    class="dialog fixed inset-0 m-auto rounded-[var(--radius-large)] bg-[var(--float-panel-bg)] p-0 w-[90%] max-w-[560px] shadow-lg overflow-hidden transition-all duration-300 ease-[cubic-bezier(0.2,0,0,1)] opacity-0 scale-95 translate-y-2.5"
>
    <div
        class="absolute inset-0 bg-[image:var(--dialog-bg-img)] bg-auto bg-right-bottom bg-no-repeat opacity-18 z-0 pointer-events-none"
    >
    </div>

    <div class="relative z-10 p-8 pb-7 flex flex-col gap-5 max-h-[80vh]">
        <!-- 标题 -->
        <div
            class="flex items-center justify-center gap-2.5 text-[var(--primary)]"
        >
            <Icon name="material-symbols:policy-outline" class="text-3xl" />
            <h3 class="m-0 text-xl font-bold text-[var(--btn-plain)]">
                {privacyTitle}
            </h3>
        </div>

        <!-- 内容 -->
        <div
            class="flex flex-col gap-4 overflow-y-auto pr-1 text-sm text-[var(--content-meta)] leading-relaxed"
        >
            <p class="m-0">{privacyIntro}</p>

            <div class="flex flex-col gap-3">
                <div
                    class="flex gap-3 p-3 rounded-lg bg-[var(--btn-plain-bg)] border border-[var(--line-color)]"
                >
                    <Icon
                        name="material-symbols:shield-outline"
                        class="shrink-0 text-xl text-[var(--primary)] mt-0.5"
                    />
                    <p class="m-0">{privacyEssential}</p>
                </div>

                <div
                    class="flex gap-3 p-3 rounded-lg bg-[var(--btn-plain-bg)] border border-[var(--line-color)]"
                >
                    <Icon
                        name="material-symbols:analytics-outline"
                        class="shrink-0 text-xl text-[var(--primary)] mt-0.5"
                    />
                    <p class="m-0">{privacyAnalytics}</p>
                </div>

                <div
                    class="flex gap-3 p-3 rounded-lg bg-[var(--btn-plain-bg)] border border-[var(--line-color)]"
                >
                    <Icon
                        name="material-symbols:campaign-outline"
                        class="shrink-0 text-xl text-[var(--primary)] mt-0.5"
                    />
                    <p class="m-0">{privacyAdvertising}</p>
                </div>

                <div
                    class="flex gap-3 p-3 rounded-lg bg-[var(--btn-plain-bg)] border border-[var(--line-color)]"
                >
                    <Icon
                        name="material-symbols:extension-outline"
                        class="shrink-0 text-xl text-[var(--primary)] mt-0.5"
                    />
                    <p class="m-0">{privacyThirdParty}</p>
                </div>
            </div>

            <div
                class="flex items-center justify-center gap-1.5 text-sm text-[var(--content-meta)] m-0"
            >
                <Icon
                    name="material-symbols:info-outline"
                    class="text-xl text-[var(--primary)]"
                />
                {privacyRejectNotice}
            </div>
        </div>

        <!-- 关闭按钮 -->
        <div class="flex justify-center mt-2">
            <button
                data-privacy-close={dialogUid}
                class="border-none rounded-[8px] py-2.5 px-7 text-base font-bold cursor-pointer transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] active:scale-95 bg-transparent text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)]"
            >
                {privacyClose}
            </button>
        </div>
    </div>
</dialog>

<style>
    .dialog.dialog-show {
        opacity: 1;
        transform: scale(1) translateY(0);
    }

    .dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(5px);
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .dialog.dialog-show::backdrop {
        opacity: 1;
    }
</style>

<script
    is:inline
    define:vars={{ uid, dialogUid, ipInfoLoading, ipInfoTimeout, enable }}
>
    (function () {
        var cKey = "siteNoticeConsent";
        var consent = localStorage.getItem(cKey);
        window.__siteNoticeConsent = consent;

        // 如果协议弹窗被关闭，自动视为已同意，不做任何权限拒绝
        if (!enable) {
            localStorage.setItem(cKey, "accepted");
            window.__siteNoticeConsent = "accepted";
            window.dispatchEvent(
                new CustomEvent("siteNoticeConsentChange", {
                    detail: "accepted",
                }),
            );
            return;
        }

        if (consent === "accepted" || consent === "rejected") return;

        var bar = document.querySelector('[data-bid="' + uid + '"]');
        var overlay = document.querySelector('[data-overlay="' + uid + '"]');
        if (!bar) return;

        var acceptBtn = bar.querySelector('[data-consent-btn="accept"]');
        var rejectBtn = bar.querySelector('[data-consent-btn="reject"]');
        var learnMoreBtn = bar.querySelector('[data-learn-more="' + uid + '"]');
        var ipEl = bar.querySelector('p[class*="opacity"]');

        var privacyDialog = document.querySelector(
            '[data-privacy-dialog="' + dialogUid + '"]',
        );
        var privacyCloseBtn = document.querySelector(
            '[data-privacy-close="' + dialogUid + '"]',
        );

        // 显示协议弹窗
        function showBar() {
            if (overlay) {
                overlay.style.opacity = "";
                overlay.style.pointerEvents = "";
            }
            bar.style.transform = "";
            bar.style.opacity = "";
            bar.style.pointerEvents = "";
        }

        // 隐藏协议弹窗
        function hideBar() {
            if (overlay) {
                overlay.style.opacity = "0";
                overlay.style.pointerEvents = "none";
            }
            bar.style.transform = "translateY(100%)";
            bar.style.opacity = "0";
            bar.style.pointerEvents = "none";
            setTimeout(function () {
                bar.style.display = "none";
                if (overlay) overlay.style.display = "none";
            }, 400);
        }

        // 打开隐私协议弹窗
        function openPrivacyDialog() {
            if (!privacyDialog) return;
            privacyDialog.showModal();
            requestAnimationFrame(function () {
                privacyDialog.classList.add("dialog-show");
            });
        }

        // 关闭隐私协议弹窗
        function closePrivacyDialog() {
            if (!privacyDialog) return;
            privacyDialog.classList.remove("dialog-show");
            setTimeout(function () {
                if (privacyDialog.open) {
                    privacyDialog.close();
                }
            }, 250);
        }

        // 同意协议
        acceptBtn.addEventListener("click", function () {
            localStorage.setItem(cKey, "accepted");
            window.__siteNoticeConsent = "accepted";
            window.dispatchEvent(
                new CustomEvent("siteNoticeConsentChange", {
                    detail: "accepted",
                }),
            );
            hideBar();
        });

        // 拒绝协议
        rejectBtn.addEventListener("click", function () {
            localStorage.setItem(cKey, "rejected");
            window.__siteNoticeConsent = "rejected";
            window.dispatchEvent(
                new CustomEvent("siteNoticeConsentChange", {
                    detail: "rejected",
                }),
            );
            hideBar();
        });

        // 查看隐私声明
        if (learnMoreBtn) {
            learnMoreBtn.addEventListener("click", function (e) {
                e.preventDefault();
                openPrivacyDialog();
            });
        }

        // 关闭隐私弹窗
        if (privacyCloseBtn) {
            privacyCloseBtn.addEventListener("click", function () {
                closePrivacyDialog();
            });
        }

        // 点击 backdrop 关闭弹窗
        if (privacyDialog) {
            privacyDialog.addEventListener("click", function (event) {
                if (event.target === privacyDialog) {
                    closePrivacyDialog();
                }
            });
        }

        // IP 地理位置
        function atob_safe(s) {
            try {
                return atob(s);
            } catch (e) {
                return "";
            }
        }

        // 解码 API URL
        function dcd(arr) {
            var r = "";
            for (var i = 0; i < arr.length; i++) r += atob_safe(arr[i]);
            return r;
        }

        var apiA = dcd(["aHR0cHM6Ly9hcGkuaXAuc2I=", "L2dlb2lw"]);
        var apiB = dcd(["aHR0cHM6Ly9pcGFwaS5jbw==", "L2pzb24v"]);

        function fmtLoc(d, ipK, cityK, regK, ctryK, ispK) {
            var loc = [d[cityK], d[regK], d[ctryK]].filter(Boolean).join(", ");
            var ip = d[ipK] || "",
                isp = d[ispK] || "",
                txt = "";
            if (loc) {
                txt = "Location: " + loc;
                if (ip) txt += "  |  IP: " + ip;
                if (isp) txt += "  |  ISP: " + isp;
            } else if (ip) txt = "IP: " + ip;
            return txt;
        }

        (async function () {
            if (!ipEl) return;
            var txt = "";
            var done = false;
            var timeoutId = setTimeout(function () {
                if (!done) {
                    done = true;
                    ipEl.textContent = ipInfoTimeout;
                }
            }, 5000);
            try {
                var c = new AbortController(),
                    t = setTimeout(function () {
                        c.abort();
                    }, 5000);
                var r = await fetch(apiA, {
                    signal: c.signal,
                    headers: { Accept: "application/json" },
                });
                clearTimeout(t);
                if (r.ok) {
                    var d = await r.json();
                    txt = fmtLoc(d, "ip", "city", "region", "country", "isp");
                }
            } catch (e) {}
            if (!done && !txt) {
                try {
                    var c2 = new AbortController(),
                        t2 = setTimeout(function () {
                            c2.abort();
                        }, 5000);
                    var r2 = await fetch(apiB, {
                        signal: c2.signal,
                        headers: { Accept: "application/json" },
                    });
                    clearTimeout(t2);
                    if (r2.ok) {
                        var d2 = await r2.json();
                        txt = fmtLoc(
                            d2,
                            "ip",
                            "city",
                            "region",
                            "country_name",
                            "org",
                        );
                    }
                } catch (e) {}
            }
            if (!done) {
                done = true;
                clearTimeout(timeoutId);
                if (txt) ipEl.textContent = txt;
                else ipEl.textContent = ipInfoTimeout;
            }
        })();

        setTimeout(showBar, 300);
    })();
</script>
