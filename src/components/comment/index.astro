---
import type { CollectionEntry } from "astro:content";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";
import { removeFileExtension } from "@/utils/url-utils";
import Twikoo from "./Twikoo.astro";

interface Props {
	post: CollectionEntry<"posts">;
}

const { id, data } = Astro.props.post;

const slug = removeFileExtension(id);
const path = `/posts/${slug}`;
// const url = `${Astro.site?.href}${path}`;

let commentService = "";
if (commentConfig?.enable && commentConfig?.twikoo) {
	commentService = "twikoo";
}

const commentEnabled = data.comment ?? true;
---
{commentEnabled && (
  <div class="card-base p-6 mb-4">
    <div id="twikoo-initializing" class="flex flex-col items-center justify-center py-12 text-center">
      <div class="twikoo-spinner mb-3">
        <svg class="twikoo-spinner-svg" viewBox="0 0 48 48">
          <circle class="twikoo-spinner-track" cx="24" cy="24" r="20" fill="none" stroke-width="4" />
          <circle class="twikoo-spinner-arc" cx="24" cy="24" r="20" fill="none" stroke-width="4" stroke-linecap="round" />
        </svg>
      </div>
      <p class="text-lg font-bold text-black/90 dark:text-white/90">
        {i18n(I18nKey.twikooInitializing)}
      </p>
    </div>
    {commentService === 'twikoo' && (
      <div id="twikoo-comment-container" class="hidden">
        <Twikoo path={path} />
      </div>
    )}
    <div id="twikoo-not-configured" class="flex flex-col items-center justify-center py-12 text-center">
      <Icon name="material-symbols:chat-bubble-off-outline" class="text-4xl mb-4 text-[var(--primary)]"></Icon>
      <p class="text-lg font-bold text-black/90 dark:text-white/90">
        {i18n(I18nKey.twikooNotConfigured)}
      </p>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
        {i18n(I18nKey.twikooConfigHint)}
      </p>
    </div>
    <div id="twikoo-privacy-rejected" class="flex flex-col items-center justify-center py-12 text-center">
      <Icon name="material-symbols:block-outline" class="text-4xl mb-4 text-[var(--primary)]"></Icon>
      <p class="text-lg font-bold text-black/90 dark:text-white/90">
        {i18n(I18nKey.twikooPrivacyRejected)}
      </p>
    </div>
    <script is:inline>
      (function() {
        var consent = localStorage.getItem('siteNoticeConsent');
        var initializing = document.getElementById('twikoo-initializing');
        var twikooContainer = document.getElementById('twikoo-comment-container');
        var notConfigured = document.getElementById('twikoo-not-configured');
        var privacyRejected = document.getElementById('twikoo-privacy-rejected');

        function updateTwikooState(c) {
          // consent 未设置时保持初始化状态，等待用户选择
          if (c !== 'accepted' && c !== 'rejected') return;

          // 隐藏初始化状态
          if (initializing) initializing.classList.add('hidden');

          if (c === 'rejected') {
            if (twikooContainer) twikooContainer.classList.add('hidden');
            if (notConfigured) notConfigured.classList.add('hidden');
            if (privacyRejected) privacyRejected.classList.remove('hidden');
          } else {
            // accepted
            if (privacyRejected) privacyRejected.classList.add('hidden');
            if (twikooContainer) {
              // twikoo is configured, show it
              twikooContainer.classList.remove('hidden');
              if (notConfigured) notConfigured.classList.add('hidden');
            } else {
              // twikoo not configured, show fallback
              if (notConfigured) notConfigured.classList.remove('hidden');
            }
          }
        }

        updateTwikooState(consent);

        window.addEventListener('siteNoticeConsentChange', function(e) {
          updateTwikooState(e.detail);
        });
      })();
    </script>
  </div>
)}

<style>
  .twikoo-spinner {
    width: 40px;
    height: 40px;
  }

  .twikoo-spinner-svg {
    width: 100%;
    height: 100%;
    animation: twikoo-spinner-rotate 2s linear infinite;
  }

  .twikoo-spinner-track {
    stroke: rgba(156, 163, 175, 0.2);
  }

  .twikoo-spinner-arc {
    stroke: var(--primary);
    stroke-dasharray: 80, 200;
    stroke-dashoffset: 0;
    animation: twikoo-spinner-dash 1.5s ease-in-out infinite;
  }

  @keyframes twikoo-spinner-rotate {
    100% { transform: rotate(360deg); }
  }

  @keyframes twikoo-spinner-dash {
    0% {
      stroke-dasharray: 1, 200;
      stroke-dashoffset: 0;
    }
    50% {
      stroke-dasharray: 80, 200;
      stroke-dashoffset: -35;
    }
    100% {
      stroke-dasharray: 80, 200;
      stroke-dashoffset: -124;
    }
  }
</style>