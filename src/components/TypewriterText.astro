---
export interface Props {
	text: string | string[];
	speed?: number;
	deleteSpeed?: number;
	pauseTime?: number;
	class?: string;
}

const {
	text,
	speed = 100,
	deleteSpeed = 50,
	pauseTime = 2000,
	class: className = "",
} = Astro.props;

const textData = Array.isArray(text) ? JSON.stringify(text) : text;
const texts = Array.isArray(text) ? text : [text];
---

<span
	class={`typewriter ${className}`}
	data-text={textData}
	data-speed={speed}
	data-delete-speed={deleteSpeed}
	data-pause-time={pauseTime}
>
	<!-- 用于显示打字效果的容器 -->
	<span class="typewriter-display ignore"></span>
	<!-- 隐藏的真实文本源，用于翻译插件读取和无 JS 降级展示 -->
	<span class="typewriter-source" style="display:none" aria-hidden="true">
		{texts.map((t, i) => <span data-index={i}>{t}</span>)}
	</span>
</span>

<script>
	/** 打字机效果控制器 */
	class TypewriterEffect {
		private element: HTMLElement;
		private displayEl: HTMLElement;
		private sourceContainer: HTMLElement | null;
		private texts: string[];
		/** 当前轮播到的文本索引 */
		private currentTextIndex: number = 0;
		/** 打字速度（毫秒/字符） */
		private speed: number;
		/** 删除速度（毫秒/字符） */
		private deleteSpeed: number;
		/** 打完后的暂停时间（毫秒） */
		private pauseTime: number;
		/** 当前文本的字符索引 */
		private currentIndex: number = 0;
		/** 是否处于删除模式 */
		private isDeleting: boolean = false;
		/** setTimeout 的 ID，用于清理 */
		private timeoutId: number | null = null;
		/** 绑定后的 translate:applied 事件处理器 */
		private boundOnTranslateApplied: (e: Event) => void;

		constructor(element: HTMLElement) {
			this.element = element;

			// 获取或创建显示容器
			this.displayEl = element.querySelector(
				".typewriter-display",
			) as HTMLElement;
			if (!this.displayEl) {
				this.displayEl = document.createElement("span");
				this.displayEl.className = "typewriter-display";
				element.prepend(this.displayEl);
			}

			this.sourceContainer = element.querySelector(".typewriter-source");
			this.texts = this.readTexts();

			this.speed = parseInt(element.dataset.speed || "100");
			this.deleteSpeed = parseInt(element.dataset.deleteSpeed || "50");
			this.pauseTime = parseInt(element.dataset.pauseTime || "2000");

			// 如果有多段文本且未显式开启打字机参数，则随机显示一段
			if (this.texts.length > 1 && !this.isTypewriterEnabled()) {
				this.showRandomText();
			} else {
				this.start();
			}

			// 监听翻译事件，翻译后自动更新文本
			this.boundOnTranslateApplied = this.onTranslateApplied.bind(this);
			document.addEventListener(
				"translate:applied",
				this.boundOnTranslateApplied,
			);
		}

		/** 从 DOM 或 data-text 中读取文本数组 */
		private readTexts(): string[] {
			if (this.sourceContainer) {
				const spans =
					this.sourceContainer.querySelectorAll("span[data-index]");
				const result = Array.from(spans)
					.sort((a, b) => {
						const ai = parseInt(
							(a as HTMLElement).dataset.index || "0",
						);
						const bi = parseInt(
							(b as HTMLElement).dataset.index || "0",
						);
						return ai - bi;
					})
					.map((span) => span.textContent || "")
					.filter((t) => t);
				if (result.length > 0) return result;
			}

			const textData = this.element.dataset.text || "";
			try {
				const parsed = JSON.parse(textData);
				return Array.isArray(parsed) ? parsed : [textData];
			} catch {
				return [textData];
			}
		}

		/** 翻译应用后的回调：更新文本并继续打字 */
		private onTranslateApplied() {
			if (!this.sourceContainer) return;

			const newTexts = this.readTexts();
			if (
				newTexts.length > 0 &&
				JSON.stringify(newTexts) !== JSON.stringify(this.texts)
			) {
				this.texts = newTexts;
				this.element.dataset.text = JSON.stringify(newTexts);
				this.continueWithTranslatedText();
			}
		}

		/** 翻译后重置状态并从新文本继续打字 */
		private continueWithTranslatedText() {
			if (this.timeoutId) {
				clearTimeout(this.timeoutId);
				this.timeoutId = null;
			}

			if (this.currentTextIndex >= this.texts.length) {
				this.currentTextIndex = 0;
			}

			this.currentIndex = 0;
			this.isDeleting = false;
			this.displayEl.textContent = "";
			this.type();
		}

		/** 判断用户是否显式配置了打字机参数 */
		private isTypewriterEnabled(): boolean {
			return (
				this.element.dataset.speed !== undefined ||
				this.element.dataset.deleteSpeed !== undefined ||
				this.element.dataset.pauseTime !== undefined
			);
		}

		/** 随机显示一段文本（非打字机模式） */
		private showRandomText() {
			const randomIndex = Math.floor(Math.random() * this.texts.length);
			this.displayEl.textContent = this.texts[randomIndex];
		}

		/** 启动打字机效果 */
		private start() {
			if (this.texts.length === 0) return;
			this.type();
		}

		/** 获取当前要显示的完整文本 */
		private getCurrentText(): string {
			return this.texts[this.currentTextIndex] || "";
		}

		/** 核心打字/删除循环 */
		private type() {
			const currentText = this.getCurrentText();

			if (this.isDeleting) {
				// 删除模式：逐个删除字符
				if (this.currentIndex > 0) {
					this.currentIndex--;
					this.displayEl.textContent = currentText.substring(
						0,
						this.currentIndex,
					);
					this.timeoutId = window.setTimeout(
						() => this.type(),
						this.deleteSpeed,
					);
				} else {
					// 删除完毕，切换到下一个文本
					this.isDeleting = false;
					this.currentTextIndex =
						(this.currentTextIndex + 1) % this.texts.length;
					this.timeoutId = window.setTimeout(
						() => this.type(),
						this.speed,
					);
				}
			} else {
				// 打字模式：逐个添加字符
				if (this.currentIndex < currentText.length) {
					this.currentIndex++;
					this.displayEl.textContent = currentText.substring(
						0,
						this.currentIndex,
					);
					this.timeoutId = window.setTimeout(
						() => this.type(),
						this.speed,
					);
				} else {
					// 当前文本打完
					if (this.texts.length > 1) {
						// 多文本：进入删除模式，暂停后删除
						this.isDeleting = true;
						this.timeoutId = window.setTimeout(
							() => this.type(),
							this.pauseTime,
						);
					} else {
						// 单文本且为空时，显示空格占位
						if (this.texts.length === 1 && this.texts[0] === "") {
							this.displayEl.innerHTML = "&nbsp;";
						}
					}
				}
			}
		}

		/** 销毁实例，清理定时器和事件监听 */
		public destroy() {
			if (this.timeoutId) {
				clearTimeout(this.timeoutId);
			}
			document.removeEventListener(
				"translate:applied",
				this.boundOnTranslateApplied,
			);
		}
	}

	/** 当前页面中所有活跃的打字机实例 */
	let activeInstances: TypewriterEffect[] = [];

	/** 清理所有打字机实例 */
	function cleanupTypewriters() {
		activeInstances.forEach((instance) => instance.destroy());
		activeInstances = [];
	}

	// 页面加载完成后初始化打字机效果
	document.addEventListener("DOMContentLoaded", () => {
		const typewriterElements = document.querySelectorAll(".typewriter");
		typewriterElements.forEach((element) => {
			activeInstances.push(new TypewriterEffect(element as HTMLElement));
		});
	});

	// Swup 页面切换前清理旧实例
	document.addEventListener("swup:willReplaceContent", () => {
		cleanupTypewriters();
	});

	// Swup 页面切换后重新初始化
	document.addEventListener("swup:contentReplaced", () => {
		cleanupTypewriters();
		const typewriterElements = document.querySelectorAll(".typewriter");
		typewriterElements.forEach((element) => {
			activeInstances.push(new TypewriterEffect(element as HTMLElement));
		});
	});
</script>

<style>
	.typewriter {
		position: relative;
		min-height: 1.5em;
		display: inline-block;
		vertical-align: baseline;
	}

	/** 空显示容器时插入不可见空格，保持行高稳定 */
	.typewriter-display:empty::before {
		content: "\00A0";
		visibility: hidden;
	}
</style>