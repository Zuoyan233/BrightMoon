---
interface Props {
	badge?: string; // 右侧徽标（如分类文章数量）
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---

<!-- 带徽标的链接按钮：用于侧边栏分类列表，右侧可显示数量徽标 -->
<a href={url} aria-label={label}>
    <button
        class:list={`
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            pl-2
            hover:pl-3
            text-75
            hover:text-[var(--primary)]
            dark:hover:text-[var(--primary)]
        `}
    >
        <div class="flex items-center justify-between relative mr-2">
            <div
                class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis"
            >
                <slot />
            </div>
            {
                badge !== undefined && badge !== null && badge !== "" && (
                    <div
                        class="transition px-2 h-7 ml-4 min-w-[2rem] rounded-lg text-sm font-bold
                    bg-[var(--btn-regular-bg)] text-[var(--btn-content)] text-75
                    flex items-center justify-center"
                    >
                        {badge}
                    </div>
                )
            }
        </div>
    </button>
</a>
