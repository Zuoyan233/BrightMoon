---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";

interface BreadcrumbItem {
	label: string;
	href?: string;
	icon?: string;
	suggestionLabel?: string;
}

interface Props {
	items: BreadcrumbItem[];
	className?: string;
}

const { items, className } = Astro.props;
---

<div class:list={["mb-4", className]}>
  <div
    class="breadcrumb-container flex items-center gap-1 px-3 py-2 bg-[var(--card-bg)] rounded-[var(--radius-large)] overflow-x-auto"
  >
    <button
      id="nav-back"
      disabled
      title={i18n(I18nKey.navBack)}
      class="nav-btn flex items-center justify-center w-8 h-8 mr-2 px-3 rounded-lg border-none bg-transparent cursor-pointer text-neutral-500 dark:text-neutral-400 transition-all duration-200 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] dark:hover:text-[var(--primary)] disabled:cursor-not-allowed disabled:text-neutral-300 disabled:dark:text-neutral-600 disabled:hover:bg-transparent disabled:hover:text-neutral-300 disabled:hover:dark:text-neutral-600"
      aria-label="Back"
    >
      <Icon
        name="material-symbols:arrow-left-alt"
        class="text-xl leading-none shrink-0"
      />
    </button>
    <button
      id="nav-forward"
      disabled
      title={i18n(I18nKey.navForward)}
      class="nav-btn flex items-center justify-center w-8 h-8 mr-2 px-3 rounded-lg border-none bg-transparent cursor-pointer text-neutral-500 dark:text-neutral-400 transition-all duration-200 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] dark:hover:text-[var(--primary)] disabled:cursor-not-allowed disabled:text-neutral-300 disabled:dark:text-neutral-600 disabled:hover:bg-transparent disabled:hover:text-neutral-300 disabled:hover:dark:text-neutral-600"
      aria-label="Forward"
    >
      <Icon
        name="material-symbols:arrow-right-alt"
        class="text-xl leading-none shrink-0"
      />
    </button>

    <a
      href="/"
      class="group flex items-center gap-1 rounded-lg transition-all duration-200 ease-out whitespace-nowrap shrink-0 px-2 py-2 cursor-pointer border-none bg-transparent text-sm text-neutral-500 dark:text-neutral-400 no-underline hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] dark:hover:text-[var(--primary)]"
      aria-label={i18n(I18nKey.home)}
    >
      <span
        class="flex items-center justify-center w-8 h-8 mr-2 rounded-lg btn-regular group-hover:bg-[var(--primary)] transition-colors duration-200"
      >
        <Icon
          name="material-symbols:home"
          class="text-xl leading-none shrink-0 text-[var(--btn-content)] transition-colors duration-200 group-hover:text-white"
        />
      </span>
      <span class="leading-none inline-flex items-center"
        >{i18n(I18nKey.home)}</span
      >
    </a>
    {
      items.map((item) => (
        <>
          <div class="flex items-center text-[var(--primary)] opacity-50 shrink-0">
            <Icon
              name="material-symbols:chevron-right-rounded"
              class="text-xl leading-none"
            />
          </div>
          {item.href ? (
            <a
              href={item.href}
              title={item.label}
              class="group flex items-center gap-1 rounded-lg transition-all duration-200 ease-out whitespace-nowrap shrink-0 px-2 py-2 cursor-pointer border-none bg-transparent text-sm text-neutral-500 dark:text-neutral-400 no-underline hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] dark:hover:text-[var(--primary)]"
            >
              {item.icon ? (
                <span class="flex items-center justify-center w-8 h-8 mr-2 rounded-lg btn-regular group-hover:bg-[var(--primary)] transition-colors duration-200">
                  <Icon
                    name={item.icon}
                    class="text-xl leading-none shrink-0 text-[var(--btn-content)] transition-colors duration-200 group-hover:text-white"
                  />
                </span>
              ) : null}
              <span class="leading-none inline-flex items-center gap-1">
                {item.suggestionLabel ? (
                  <>
                    <span class="suggestion-prefix shrink-0">
                      {item.suggestionLabel}
                    </span>
                    <span class="shrink-0">: </span>
                  </>
                ) : null}
                <span>{item.label}</span>
              </span>
            </a>
          ) : (
            <span
              class="group flex items-center gap-1 rounded-lg whitespace-nowrap shrink-0 px-2 py-2 text-sm font-bold text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)]"
              title={item.label}
            >
              {item.icon ? (
                <span class="flex items-center justify-center w-8 h-8 mr-2 rounded-lg btn-regular group-hover:bg-[var(--primary)] transition-colors duration-200">
                  <Icon
                    name={item.icon}
                    class="text-xl leading-none shrink-0 text-[var(--btn-content)] transition-colors duration-200 group-hover:text-white"
                  />
                </span>
              ) : null}
              <span class="leading-none inline-flex items-center">
                {item.label}
              </span>
            </span>
          )}
        </>
      ))
    }
  </div>
</div>

<style is:global>
  .breadcrumb-container {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .breadcrumb-container::-webkit-scrollbar {
    display: none;
  }
  body.wallpaper-transparent .breadcrumb-container {
    background: var(--card-bg-transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
</style>

<script>
  const SITE_NAV_STACK = "siteNavStack";
  const SITE_NAV_PENDING = "siteNavPendingIdx";
  const SITE_SCROLL_POS = "siteNavScrollPositions";

  function getCurrentFullPath(): string {
    return window.location.pathname + window.location.search;
  }

  function saveScrollPosition() {
    const path = getCurrentFullPath();
    try {
      const positions = JSON.parse(
        sessionStorage.getItem(SITE_SCROLL_POS) || "{}",
      );
      positions[path] = { x: window.scrollX, y: window.scrollY };
      sessionStorage.setItem(SITE_SCROLL_POS, JSON.stringify(positions));
    } catch (e) {
      // ignore
    }
  }

  function restoreScrollPosition() {
    const path = getCurrentFullPath();
    try {
      const positions = JSON.parse(
        sessionStorage.getItem(SITE_SCROLL_POS) || "{}",
      );
      const saved = positions[path];
      if (saved && (saved.x !== undefined || saved.y !== undefined)) {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            window.scrollTo(saved.x || 0, saved.y || 0);
          });
        });
      }
    } catch (e) {
      // ignore
    }
  }

  function navigateTo(url: string, targetIndex: number) {
    saveScrollPosition();
    sessionStorage.setItem(SITE_NAV_PENDING, String(targetIndex));
    if (window.swup) {
      try {
        window.swup.navigate(url);
        return;
      } catch (e) {}
    }
    window.location.href = url;
  }

  function initBreadcrumbNav() {
    const backBtn = document.getElementById(
      "nav-back",
    ) as HTMLButtonElement | null;
    const forwardBtn = document.getElementById(
      "nav-forward",
    ) as HTMLButtonElement | null;
    if (!backBtn || !forwardBtn) return;

    const currentPath = window.location.pathname + window.location.search;

    let navStack: { paths: string[]; index: number } | null;
    try {
      navStack = JSON.parse(sessionStorage.getItem(SITE_NAV_STACK) || "null");
    } catch (e) {
      navStack = null;
    }

    let pendingIdx: number | null = null;
    try {
      pendingIdx = parseInt(sessionStorage.getItem(SITE_NAV_PENDING) || "", 10);
      if (isNaN(pendingIdx)) pendingIdx = null;
      sessionStorage.removeItem(SITE_NAV_PENDING);
    } catch (e) {}

    if (
      pendingIdx !== null &&
      navStack &&
      navStack.paths[pendingIdx] === currentPath
    ) {
      navStack.index = pendingIdx;
    } else if (!navStack || !Array.isArray(navStack.paths)) {
      navStack = { paths: [currentPath], index: 0 };
    } else if (
      navStack.index > 0 &&
      navStack.paths[navStack.index - 1] === currentPath
    ) {
      navStack.index--;
    } else if (
      navStack.index < navStack.paths.length - 1 &&
      navStack.paths[navStack.index + 1] === currentPath
    ) {
      navStack.index++;
    } else if (navStack.paths[navStack.index] === currentPath) {
      // same page, no change
    } else {
      navStack.paths = navStack.paths.slice(0, navStack.index + 1);
      navStack.paths.push(currentPath);
      navStack.index = navStack.paths.length - 1;
    }

    sessionStorage.setItem(SITE_NAV_STACK, JSON.stringify(navStack));

    backBtn.disabled = navStack.index <= 0;
    forwardBtn.disabled = navStack.index >= navStack.paths.length - 1;

    backBtn.onclick = () => {
      let stack: { paths: string[]; index: number } | null;
      try {
        stack = JSON.parse(sessionStorage.getItem(SITE_NAV_STACK) || "null");
      } catch (e) {
        stack = null;
      }
      if (stack && stack.index > 0) {
        navigateTo(stack.paths[stack.index - 1], stack.index - 1);
      }
    };

    forwardBtn.onclick = () => {
      let stack: { paths: string[]; index: number } | null;
      try {
        stack = JSON.parse(sessionStorage.getItem(SITE_NAV_STACK) || "null");
      } catch (e) {
        stack = null;
      }
      if (stack && stack.index < stack.paths.length - 1) {
        navigateTo(stack.paths[stack.index + 1], stack.index + 1);
      }
    };

    restoreScrollPosition();
  }

  initBreadcrumbNav();
  document.addEventListener("astro:page-load", initBreadcrumbNav);

  // 保存滚动位置：完整页面导航时
  window.addEventListener("beforeunload", saveScrollPosition);

  // 保存滚动位置：Swup 无刷新导航时
  if (window.swup) {
    window.swup.hooks.on("animation:out:start", saveScrollPosition);
  }

  // 恢复滚动位置：Swup 页面切换完成后（延迟以确保覆盖其他滚动逻辑）
  document.addEventListener("swup:page:view", () => {
    setTimeout(restoreScrollPosition, 100);
  });
</script>
