---
/**
 * AnalyticsScripts.astro
 * 第三方分析脚本组件
 *
 * 包含:
 * - Google Tag Manager (GTM，需配置 gtmId)
 * - Microsoft Clarity (需配置 clarityId)
 *
 */

import type { ThirdPartyAnalyticsConfig } from "@/types/config";

interface Props {
	thirdPartyAnalytics?: ThirdPartyAnalyticsConfig;
}

const {
	thirdPartyAnalytics = { enable: false, gtmId: "", clarityId: "" },
} = Astro.props;

const analyticsEnabled = thirdPartyAnalytics.enable;
const gtmEnable = analyticsEnabled && !!thirdPartyAnalytics.gtmId;
const clarityEnable = analyticsEnabled && !!thirdPartyAnalytics.clarityId;
---

{
	gtmEnable || clarityEnable ? (
		<script
			is:inline
			define:vars={{
				gtmEnable,
				gtmId: thirdPartyAnalytics.gtmId || "",
				clarityEnable,
				clarityId: thirdPartyAnalytics.clarityId || "",
			}}
		>
			(function () {
				window.analyticsLoaded = window.analyticsLoaded || false;

				function loadAnalytics() {
					if (window.analyticsLoaded) return;
					window.analyticsLoaded = true;

					// Google Tag Manager
					if (gtmEnable && gtmId) {
						(function (w, d, s, l, i) {
							w[l] = w[l] || [];
							w[l].push({
								"gtm.start": new Date().getTime(),
								event: "gtm.js",
							});
							var f = d.getElementsByTagName(s)[0],
								j = d.createElement(s);
							j.async = true;
							j.src =
								"https://www.googletagmanager.com/gtm.js?id=" +
								i;
							f.parentNode.insertBefore(j, f);
						})(window, document, "script", "dataLayer", gtmId);
					}

					// Microsoft Clarity
					if (clarityEnable && clarityId) {
						(function (c, l, a, r, i, t, y) {
							c[a] =
								c[a] ||
								function () {
									(c[a].q = c[a].q || []).push(arguments);
								};
							t = l.createElement(r);
							t.async = 1;
							t.src = "https://www.clarity.ms/tag/" + i;
							y = l.getElementsByTagName(r)[0];
							y.parentNode.insertBefore(t, y);
						})(window, document, "clarity", "script", clarityId);
					}
				}

				// 仅在用户交互后加载，减少初始页面负担
				var events = [
					"scroll",
					"mousemove",
					"keydown",
					"touchstart",
					"click",
				];
				var loaded = false;

				function onInteraction() {
					if (loaded) return;
					loaded = true;
					events.forEach(function (event) {
						window.removeEventListener(event, onInteraction);
					});
					loadAnalytics();
				}

				events.forEach(function (event) {
					window.addEventListener(event, onInteraction, {
						once: true,
						passive: true,
					});
				});

				// 备用：10 秒内无交互则自动加载
				setTimeout(function () {
					if (!loaded) loadAnalytics();
				}, 10000);
			})();
		</script>
	) : null
}