---
/**
 * 第三方分析脚本组件
 */

import type { ThirdPartyAnalyticsConfig } from "@/types/config";

// 组件属性接口
interface Props {
	thirdPartyAnalytics?: ThirdPartyAnalyticsConfig;
}

// 组件属性
const { thirdPartyAnalytics = { enable: false, gtmId: "", clarityId: "" } } =
	Astro.props;

// 分析脚本是否启用
const analyticsEnabled = thirdPartyAnalytics.enable;
const gtmEnable = analyticsEnabled && !!thirdPartyAnalytics.gtmId;
const clarityEnable = analyticsEnabled && !!thirdPartyAnalytics.clarityId;
---

{
	gtmEnable || clarityEnable ? (
		<script
			is:inline
			define:vars={{
				gtmEnable,
				gtmId: thirdPartyAnalytics.gtmId || "",
				clarityEnable,
				clarityId: thirdPartyAnalytics.clarityId || "",
			}}
		>
			(function () {
				window.analyticsLoaded = window.analyticsLoaded || false;

				function loadAnalytics() {
					if (window.analyticsLoaded) return;
					window.analyticsLoaded = true;

					// 加载 Google Tag Manager
					if (gtmEnable && gtmId) {
						(function (w, d, s, l, i) {
							w[l] = w[l] || [];
							w[l].push({
								"gtm.start": new Date().getTime(),
								event: "gtm.js",
							});
							var f = d.getElementsByTagName(s)[0],
								j = d.createElement(s);
							j.async = true;
							j.src =
								"https://www.googletagmanager.com/gtm.js?id=" +
								i;
							f.parentNode.insertBefore(j, f);
						})(window, document, "script", "dataLayer", gtmId);
					}

					// 加载 Microsoft Clarity
					if (clarityEnable && clarityId) {
						(function (c, l, a, r, i, t, y) {
							c[a] =
								c[a] ||
								function () {
									(c[a].q = c[a].q || []).push(arguments);
								};
							t = l.createElement(r);
							t.async = 1;
							t.src = "https://www.clarity.ms/tag/" + i;
							y = l.getElementsByTagName(r)[0];
							y.parentNode.insertBefore(t, y);
						})(window, document, "clarity", "script", clarityId);
					}
				}

				function canLoadAnalytics() {
					return window.__siteNoticeConsent === "accepted";
				}

				function tryLoadAnalytics() {
					if (canLoadAnalytics()) {
						loadAnalytics();
						return true;
					}
					return false;
				}

				// 用户交互触发加载（滚动、鼠标、按键、触摸、点击）
				var events = ["scroll", "mousemove", "keydown", "touchstart", "click"];
				function onUserInteraction() {
					if (tryLoadAnalytics()) {
						events.forEach(function (ev) {
							window.removeEventListener(ev, onUserInteraction);
						});
					}
				}
				events.forEach(function (ev) {
					window.addEventListener(ev, onUserInteraction, { passive: true });
				});

				// 10 秒后无交互也自动加载
				setTimeout(function () {
					if (tryLoadAnalytics()) {
						events.forEach(function (ev) {
							window.removeEventListener(ev, onUserInteraction);
						});
					}
				}, 10000);

				// 监听同意隐私协议的事件
				function onConsentChange(e) {
					if (e.detail === "rejected") {
						// 用户拒绝后，清理所有交互监听器
						events.forEach(function (ev) {
							window.removeEventListener(ev, onUserInteraction);
						});
					}
					window.removeEventListener("siteNoticeConsentChange", onConsentChange);
				}
				window.addEventListener("siteNoticeConsentChange", onConsentChange);
			})();
		</script>
	) : null
}