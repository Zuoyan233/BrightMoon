---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	let srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] =>
		Array.isArray(src) ? src : typeof src === "string" ? [src] : [];

	if (
		typeof srcConfig === "object" &&
		srcConfig !== null &&
		!Array.isArray(srcConfig)
	) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) return null;

// 轮播配置
const isCarouselEnabled =
	config.carousel?.enable &&
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;

// 样式配置 - position 改为通过内联脚本从 localStorage 动态读取
// 默认值从 config 获取，存储在 data 属性中供客户端读取
const defaultPosition =
	siteConfig.appearance.wallpaperMode.defaultFullscreenPosition || "center";
const defaultOpacity = siteConfig.appearance.wallpaperMode.defaultOpacity ?? 1;
const defaultBlur = siteConfig.appearance.wallpaperMode.defaultBlur ?? 8;

// 服务端渲染时使用默认值，客户端通过内联脚本动态替换
const opacity = defaultOpacity;
const blurAmount = defaultBlur;
const positionClass = (() => {
	switch (defaultPosition) {
		case "top":
			return "object-top";
		case "bottom":
			return "object-bottom";
		default:
			return "object-center";
	}
})();

const renderGroups = [
	{
		key: "desktop",
		images: imageSources.desktop,
		containerClass: "hidden md:block",
		hasImages: hasDesktopImages,
	},
	{
		key: "mobile",
		images: imageSources.mobile,
		containerClass: "block md:hidden",
		hasImages: hasMobileImages,
	},
];
---

<div 
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className
	]}
	style={`opacity: ${opacity}; transform: translateZ(0); perspective: 1000px; transition: opacity 0.7s ease;`}
	data-fullscreen-wallpaper
	data-default-fullscreen-position={defaultPosition}
	data-default-opacity={defaultOpacity}
	data-default-blur={defaultBlur}
	data-default-card-opacity={siteConfig.appearance.wallpaperMode.defaultCardOpacity ?? 0.8}
	data-default-wallpaper-mode={siteConfig.appearance.wallpaperMode.defaultMode || 'banner'}
>
	<script is:inline>
	// 立即执行脚本：防止闪烁
	(function() {
		const container = document.currentScript.parentElement;
		const defaultMode = container.getAttribute('data-default-wallpaper-mode') || 'banner';
		const mode = localStorage.getItem('wallpaperMode') || defaultMode;
		if (mode !== 'fullscreen') {
			container.classList.add('wallpaper-hiding');
		}
	})();
	</script>
	<script is:inline>
	// 动态应用壁纸位置
	(function() {
		const POSITION_CLASSES = {
			top: 'object-top',
			center: 'object-center',
			bottom: 'object-bottom'
		};
		const container = document.currentScript.parentElement;
		const defaultPosition = container.getAttribute('data-default-fullscreen-position') || 'center';

		function applyWallpaperPosition(position) {
			const images = container.querySelectorAll('img');
			images.forEach(img => {
				// 移除所有位置类
				Object.values(POSITION_CLASSES).forEach(cls => img.classList.remove(cls));
				// 添加正确的类
				const targetClass = POSITION_CLASSES[position] || POSITION_CLASSES.center;
				img.classList.add(targetClass);
			});
		}

		// 初始应用
		const storedPosition = localStorage.getItem('wallpaperPosition');
		applyWallpaperPosition(storedPosition || defaultPosition);

		// 监听位置变化
		window.addEventListener('wallpaper-position-change', function(e) {
			if (e.detail && e.detail.position) {
				applyWallpaperPosition(e.detail.position);
			}
		});
	})();
	</script>
	<script is:inline>
	// 动态应用壁纸透明度和模糊
	(function() {
		const container = document.currentScript.parentElement;
		const rawOpacity = parseFloat(container.getAttribute('data-default-opacity'));
		const defaultOpacity = isNaN(rawOpacity) ? 1 : rawOpacity;
		const rawBlur = parseFloat(container.getAttribute('data-default-blur'));
		const defaultBlur = isNaN(rawBlur) ? 8 : rawBlur;

		function applyOpacity(value) {
			container.style.opacity = value / 100;
		}

		function applyBlur(value) {
			const images = container.querySelectorAll('img');
			images.forEach(img => {
				if (value > 0) {
					img.style.filter = `blur(${value}px)`;
				} else {
					img.style.filter = '';
				}
			});
		}

		// 初始应用
		const storedOpacity = localStorage.getItem('wallpaperOpacity');
		applyOpacity(storedOpacity !== null ? parseFloat(storedOpacity) : defaultOpacity * 100);

		const storedBlur = localStorage.getItem('wallpaperBlur');
		applyBlur(storedBlur !== null ? parseFloat(storedBlur) : defaultBlur);

		// 监听变化
		window.addEventListener('wallpaper-opacity-change', function(e) {
			if (e.detail && typeof e.detail.opacity === 'number') {
				applyOpacity(e.detail.opacity);
			}
		});
		window.addEventListener('wallpaper-blur-change', function(e) {
			if (e.detail && typeof e.detail.blur === 'number') {
				applyBlur(e.detail.blur);
			}
		});
	})();
</script>
	<script is:inline>
	// 动态应用卡片透明度
	(function() {
		const container = document.currentScript.parentElement;
		const rawCardOpacity = parseFloat(container.getAttribute('data-default-card-opacity'));
		const defaultCardOpacity = isNaN(rawCardOpacity) ? 0.8 : rawCardOpacity;
		const defaultWallpaperMode = container.getAttribute('data-default-wallpaper-mode') || 'banner';

		function getEffectiveMode() {
			return localStorage.getItem('wallpaperMode') || defaultWallpaperMode;
		}

		function isFullscreenWallpaperMode() {
			return getEffectiveMode() === 'fullscreen';
		}

		function applyCardOpacity(value) {
			var alpha = value / 100;
			var isDark = document.documentElement.classList.contains('dark');
			if (isDark) {
				document.body.style.setProperty('--card-bg-transparent', 'rgba(23, 23, 23, ' + alpha + ')');
			} else {
				document.body.style.setProperty('--card-bg-transparent', 'rgba(255, 255, 255, ' + alpha + ')');
			}
		}

		function resetCardOpacity() {
			document.body.style.removeProperty('--card-bg-transparent');
		}

		function applyStoredCardOpacity() {
			var storedCardOpacity = localStorage.getItem('cardOpacity');
			applyCardOpacity(storedCardOpacity !== null ? parseFloat(storedCardOpacity) : defaultCardOpacity * 100);
		}

		if (isFullscreenWallpaperMode()) {
			applyStoredCardOpacity();
		}

		window.addEventListener('card-opacity-change', function(e) {
			if (e.detail && typeof e.detail.opacity === 'number' && isFullscreenWallpaperMode()) {
				applyCardOpacity(e.detail.opacity);
			}
		});

		window.addEventListener('wallpaper-mode-change', function(e) {
			if (e.detail && e.detail.mode === 'fullscreen') {
				applyStoredCardOpacity();
			} else {
				resetCardOpacity();
			}
		});

		var observer = new MutationObserver(function() {
			if (isFullscreenWallpaperMode()) {
				applyStoredCardOpacity();
			}
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
	})();
</script>

	{isCarouselEnabled ? (
		renderGroups.map(group => group.hasImages && (
			<div class={`${group.containerClass} w-full h-full relative`} style="transform: translateZ(0);">
				{group.images.map((src, index) => (
					<img
						src={src}
						alt={`${group.key} wallpaper ${index + 1}`}
						class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}`}
						data-carousel-item={index}
						style={`transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''}; opacity: ${index === 0 ? 1 : 0};`}
						decoding="async"
						loading={index === 0 ? "eager" : "lazy"} 
					/>
				))}
			</div>
		))
	) : (
		<div id="wallpaper-single-container" class="w-full h-full relative">
			<script is:inline define:vars={{ desktopImages: imageSources.desktop, mobileImages: imageSources.mobile, positionClass, blurAmount }}>
				(function() {
					const getRandomImage = (images, storageKey) => {
						if (images.length === 0) return null;
						if (images.length === 1) return images[0];
						
						const lastIndex = sessionStorage.getItem(storageKey);
						let newIndex;
						
						do {
							newIndex = Math.floor(Math.random() * images.length);
						} while (newIndex === parseInt(lastIndex || '-1'));
						
						sessionStorage.setItem(storageKey, newIndex.toString());
						return images[newIndex];
					};
					
					const desktopSrc = getRandomImage(desktopImages, 'wallpaper_desktop_index');
					const mobileSrc = getRandomImage(mobileImages, 'wallpaper_mobile_index');
					
					const container = document.getElementById('wallpaper-single-container');
					
					if (desktopSrc) {
						const desktopDiv = document.createElement('div');
						desktopDiv.className = 'hidden lg:block w-full h-full relative';
						desktopDiv.style.transform = 'translateZ(0)';
						desktopDiv.innerHTML = `
							<img
								src="${desktopSrc}"
								alt="desktop wallpaper"
								class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
								style="transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;"
								decoding="async"
								loading="eager"
							/>
						`;
						container.appendChild(desktopDiv);
					}
					
					if (mobileSrc) {
						const mobileDiv = document.createElement('div');
						mobileDiv.className = 'block lg:hidden w-full h-full relative';
						mobileDiv.style.transform = 'translateZ(0)';
						mobileDiv.innerHTML = `
							<img
								src="${mobileSrc}"
								alt="mobile wallpaper"
								class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${positionClass}"
								style="transform: translateZ(0); backface-visibility: hidden; will-change: opacity; ${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ''} opacity: 1;"
								decoding="async"
								loading="eager"
							/>
						`;
						container.appendChild(mobileDiv);
					}
				})();
			</script>
		</div>
	)}
</div>

{isCarouselEnabled && (
	<script is:inline define:vars={{ carouselInterval }}>
		function initFullscreenWallpaperCarousel() {
			const container = document.querySelector('[data-fullscreen-wallpaper]');
			if (!container) return;

			if (window.__wallpaper_cleanup) {
				window.__wallpaper_cleanup();
				window.__wallpaper_cleanup = null;
			}

			const STORAGE_KEY = 'brightmoon_wallpaper_index';
			let savedIndex = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0');

			const groups = [
				container.querySelectorAll('.hidden.md\\:block [data-carousel-item]'),
				container.querySelectorAll('.block.md\\:hidden [data-carousel-item]')
			];

			const state = groups.map(items => {
				const safeIndex = (savedIndex >= 0 && savedIndex < items.length) ? savedIndex : 0;
				return {
					items,
					currentIndex: safeIndex,
					timer: null,
					active: items.length > 1
				};
			});

			// 初始化显示：根据 savedIndex 立即修正图片显示
			function initImage(stateItem) {
				const { items, currentIndex } = stateItem;
				// 立即设置样式，防止视觉上跳回第一张
				for (let i = 0; i < items.length; i++) {
					items[i].style.opacity = i === currentIndex ? '1' : '0';
				}
			}

			// 切换下一张
			function switchNextImage(stateItem) {
				const { items, currentIndex } = stateItem;
				const nextIndex = (currentIndex + 1) % items.length;
				
				items[currentIndex].style.opacity = '0';
				items[nextIndex].style.opacity = '1';
				
				stateItem.currentIndex = nextIndex;

				sessionStorage.setItem(STORAGE_KEY, nextIndex.toString());
			}

			function start() {
				state.forEach(s => {
					if (s.active && !s.timer) {
						s.timer = setInterval(() => {
							if (!document.body.contains(s.items[0])) {
								stop();
								return;
							}
							switchNextImage(s);
						}, carouselInterval * 1000);
					}
				});
			}

			function stop() {
				state.forEach(s => {
					if (s.timer) {
						clearInterval(s.timer);
						s.timer = null;
					}
				});
			}

			const handleVisibilityChange = () => {
				if (document.hidden) {
					stop();
				} else {
					const exists = state.some(s => s.items.length > 0 && document.body.contains(s.items[0]));
					if (exists) start();
				}
			};

			// 初始化状态
			state.forEach(s => {
				if (s.items.length > 0) initImage(s);
			});

			start();

			document.addEventListener('visibilitychange', handleVisibilityChange);

			window.__wallpaper_cleanup = () => {
				stop();
				document.removeEventListener('visibilitychange', handleVisibilityChange);
			};
		}

		// 页面加载完成后初始化轮播
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initFullscreenWallpaperCarousel);
		} else {
			initFullscreenWallpaperCarousel();
		}
	</script>
)}

<style is:global>
.wallpaper-hiding {
    opacity: 0 !important;
    pointer-events: none !important;
}
</style>