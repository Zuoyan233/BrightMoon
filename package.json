		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.90",
		"@iconify-json/simple-icons": "^1.2.94",
		"@iconify/svelte": "^5.2.2",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.20",
		"astro": "7.2.9",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.2.0",
