		"@types/markdown-it": "^14.2.0",
		"@types/mdast": "^4.0.4",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.1",
		"fontmin": "^1.1.1",
		"globals": "^17.11.0",
		"postcss-import": "^17.0.0",
		"postcss-nesting": "^14.0.1"
