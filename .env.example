# Mizuki 博客环境变量配置示例
# 复制此文件为 .env 并根据需要填写实际值

# ============================================
# 统计与分析
# ============================================

# Umami API 密钥，用于访问 Umami 统计数据
# 如果在 config.ts 中启用了 Umami，建议在此配置 API 密钥
UMAMI_API_KEY=your_umami_api_key_here

# ============================================
# IndexNow SEO 配置
# ============================================

# IndexNow API 密钥，用于向搜索引擎提交 URL 更新
INDEXNOW_KEY=asdf1213456
# 网站主机地址
INDEXNOW_HOST=your.example.com